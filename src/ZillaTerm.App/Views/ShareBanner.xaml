<UserControl x:Class="ZillaTerm.App.Views.ShareBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ZillaTerm.App.Views"
             xmlns:loc="clr-namespace:ZillaTerm.App.Localization"
             Visibility="Collapsed">
    <!-- Session partagée : rappel permanent au-dessus de la session (qui regarde, qui a la main, jusqu'à quand), demandes
         en attente et arrêt en un clic. Pas de touches d'accès : Alt+lettre appartient au terminal. -->
    <Border Background="{DynamicResource AccentLightBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,1" Padding="10,4">
        <StackPanel>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="TakeBackButton" Content="{x:Static loc:Strings.ShareTakeBack}" ToolTip="{x:Static loc:Strings.ShareTakeBackTip}"
                            Click="OnTakeBack" Padding="10,1" Margin="8,0,0,0" Visibility="Collapsed" />
                    <Button Content="{x:Static loc:Strings.ShareManage}" ToolTip="{x:Static loc:Strings.ShareManageTip}" Click="OnManage" Padding="10,1" Margin="8,0,0,0" />
                    <Button Content="{x:Static loc:Strings.ShareStop}" ToolTip="{x:Static loc:Strings.ShareStopTip}" Click="OnStop" Padding="10,1" Margin="8,0,0,0" />
                </StackPanel>
                <Ellipse Width="9" Height="9" Fill="{DynamicResource StateFailedBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <views:AnnouncedText x:Name="SummaryText" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
            <!-- Demandes : regarder (avec le code à vérifier), avoir la main. -->
            <StackPanel x:Name="RequestsPanel" />
        </StackPanel>
    </Border>
</UserControl>
