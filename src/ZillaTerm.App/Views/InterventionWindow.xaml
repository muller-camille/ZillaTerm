<Window x:Class="ZillaTerm.App.Views.InterventionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ZillaTerm.App.Views"
        xmlns:loc="clr-namespace:ZillaTerm.App.Localization"
        Title="{x:Static loc:Strings.InterventionTitle}" Width="660" Height="700" MinWidth="500" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="{x:Static loc:Strings.CloseButton}" IsCancel="True" Click="OnClose" />
            <views:AnnouncedText x:Name="MessageText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                                 AutomationProperties.LiveSetting="Polite" />
        </DockPanel>

        <!-- Enregistrement et interventions précédentes, sous les consignes d'astreinte. -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock Text="{x:Static loc:Strings.InterventionRecordingSection}" Style="{StaticResource SectionTitle}" />
            <DockPanel Margin="0,0,0,4">
                <Button x:Name="RecordButton" DockPanel.Dock="Left" Click="OnRecord" MinWidth="210">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="RecordDot" Width="10" Height="10" Fill="#D32F2F" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <Rectangle x:Name="StopSquare" Width="10" Height="10" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   Margin="0,0,7,0" VerticalAlignment="Center" Visibility="Collapsed" />
                        <AccessText x:Name="RecordLabel" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <views:AnnouncedText x:Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"
                                     AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
            <TextBlock Style="{StaticResource OptionHelp}" Text="{x:Static loc:Strings.InterventionRecordingHelp}" Margin="0,4,0,8" />
            <!-- Titre, notes, captures et historique : onglet « Intervention » du panneau de gauche, montré au début de
                 l'enregistrement. -->
            <Button x:Name="NotesButton" Click="OnOpenNotes" HorizontalAlignment="Left" ToolTip="{x:Static loc:Strings.TabInterventionTip}">
                <AccessText Text="{x:Static loc:Strings.InterventionOpenNotes}" />
            </Button>

            <TextBlock Text="{x:Static loc:Strings.InterventionPreviousSection}" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                    <Button x:Name="ExportButton" Click="OnExport">
                        <AccessText Text="{x:Static loc:Strings.InterventionExportReport}" />
                    </Button>
                    <Button x:Name="DeleteButton" Click="OnDelete" Margin="0,6,0,0">
                        <AccessText Text="{x:Static loc:Strings.InterventionDelete}" />
                    </Button>
                </StackPanel>
                <ListBox x:Name="JournalList" Height="110" SelectionChanged="OnJournalSelected" MouseDoubleClick="OnJournalDoubleClick"
                         AutomationProperties.Name="{x:Static loc:Strings.InterventionPreviousSection}" />
            </DockPanel>
            <TextBlock Text="{x:Static loc:Strings.InterventionReportNotEncrypted}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                       Margin="0,6,0,0" />
        </StackPanel>

        <TextBlock x:Name="TeamTitle" DockPanel.Dock="Top" Text="{x:Static loc:Strings.DutyTeamTextSection}" Style="{StaticResource SectionTitle}" />
        <!-- Origine des consignes : fichier lu (avec son chemin), ou raison pour laquelle il ne l'a pas été. -->
        <views:AnnouncedText x:Name="ReminderSource" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,-4,0,6" Visibility="Collapsed"
                             Foreground="{DynamicResource MutedBrush}" AutomationProperties.LiveSetting="Polite" />
        <TextBlock x:Name="NoTeamText" DockPanel.Dock="Top" Text="{x:Static loc:Strings.DutyNoText}" Foreground="{DynamicResource MutedBrush}"
                   TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8" />
        <!-- Texte brut de l'équipe : sélectionnable (numéros à copier), jamais interprété (ni lien, ni mise en forme). -->
        <TextBox x:Name="TeamText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 FontSize="14" Padding="8,6" AutomationProperties.LabeledBy="{Binding ElementName=TeamTitle}" />
    </DockPanel>
</Window>
