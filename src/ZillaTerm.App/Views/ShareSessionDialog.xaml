<Window x:Class="ZillaTerm.App.Views.ShareSessionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ZillaTerm.App.Views"
        xmlns:loc="clr-namespace:ZillaTerm.App.Localization"
        Title="{x:Static loc:Strings.ShareTitle}" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource ToolbarBrush}" BorderBrush="{DynamicResource ToolbarBorderBrush}"
                BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel>
                <Image Source="{DynamicResource IconScreenShare}" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="HeadingText" Text="{x:Static loc:Strings.ShareTitle}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="SessionText" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="StartButton" IsDefault="True" Click="OnStart">
                        <AccessText Text="{x:Static loc:Strings.ShareStart}" />
                    </Button>
                    <Button x:Name="CopyButton" Click="OnCopy" Visibility="Collapsed" ToolTip="{x:Static loc:Strings.ShareCopyInvitationTip}">
                        <AccessText Text="{x:Static loc:Strings.ShareCopyInvitation}" />
                    </Button>
                    <Button x:Name="CancelButton" Content="{x:Static loc:Strings.Cancel}" IsCancel="True" Margin="8,0,0,0" />
                </StackPanel>
                <views:ErrorLine x:Name="ErrorMessage" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,16,0" />
            </DockPanel>
        </Border>

        <Grid Margin="16,12,16,12">
            <!-- Avant : durée, main possible, ce que l'on accepte en partageant. -->
            <StackPanel x:Name="OptionsPanel">
                <TextBlock Text="{x:Static loc:Strings.ShareIntro}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="140" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>
                    <Label Content="{x:Static loc:Strings.ShareDurationLabel}" Target="{Binding ElementName=DurationBox}" />
                    <ComboBox Grid.Column="1" x:Name="DurationBox" VerticalAlignment="Center" DisplayMemberPath="Value" SelectedValuePath="Key" />
                </Grid>
                <CheckBox x:Name="ControlBox" Margin="0,0,0,2">
                    <AccessText Text="{x:Static loc:Strings.ShareAllowControl}" TextWrapping="Wrap" />
                </CheckBox>
                <TextBlock x:Name="ControlHelp" Style="{StaticResource OptionHelp}" Text="{x:Static loc:Strings.ShareAllowControlHelp}" Margin="20,0,0,8" />
                <TextBlock x:Name="ScreenHelp" Style="{StaticResource OptionHelp}" Text="{x:Static loc:Strings.ShareScreenHelp}" Margin="0,0,0,8"
                           Visibility="Collapsed" />
                <Border Style="{StaticResource WarningBanner}" Margin="0,4,0,0">
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Strings.ShareWarningTitle}" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,4" />
                        <DockPanel Margin="0,0,0,3">
                            <TextBlock Text="•" Margin="0,0,6,0" DockPanel.Dock="Left" />
                            <TextBlock Text="{x:Static loc:Strings.ShareWarningVisible}" TextWrapping="Wrap" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,3">
                            <TextBlock Text="•" Margin="0,0,6,0" DockPanel.Dock="Left" />
                            <TextBlock Text="{x:Static loc:Strings.ShareWarningApproval}" TextWrapping="Wrap" />
                        </DockPanel>
                        <DockPanel>
                            <TextBlock Text="•" Margin="0,0,6,0" DockPanel.Dock="Left" />
                            <TextBlock Text="{x:Static loc:Strings.ShareWarningEnds}" TextWrapping="Wrap" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Après : l'invitation à envoyer, sa validité et par où passer. -->
            <StackPanel x:Name="InvitationPanel" Visibility="Collapsed">
                <TextBlock Text="{x:Static loc:Strings.ShareInvitationIntro}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBox x:Name="InvitationBox" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas, Courier New" Height="76"
                         VerticalScrollBarVisibility="Auto" Padding="6,4" AutomationProperties.Name="{x:Static loc:Strings.ShareInvitationName}" />
                <TextBlock x:Name="ValidityText" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock x:Name="RouteText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
                <TextBlock Text="{x:Static loc:Strings.ShareInvitationSafety}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" />
                <views:AnnouncedText x:Name="CopiedText" Foreground="{DynamicResource SuccessBrush}" Margin="0,8,0,0" Visibility="Collapsed"
                                     Text="{x:Static loc:Strings.ShareInvitationCopied}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
