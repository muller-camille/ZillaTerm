<UserControl x:Class="ZillaTerm.App.Views.InterventionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ZillaTerm.App.Views"
             xmlns:loc="clr-namespace:ZillaTerm.App.Localization">
    <!-- Onglet « Intervention » du panneau de gauche : titre, notes, captures, et ce qui s'est passé depuis le début, à côté
         de la session. -->
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <views:AnnouncedText x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
            <!-- Fin de l'intervention depuis l'onglet : l'enregistrement s'arrête (après confirmation) et l'onglet se ferme. -->
            <Button x:Name="EndButton" Click="OnEnd" HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="Collapsed"
                    ToolTip="{x:Static loc:Strings.InterventionEndTip}" AutomationProperties.HelpText="{x:Static loc:Strings.InterventionEndTip}">
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center"
                               Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <AccessText Text="{x:Static loc:Strings.InterventionEnd}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Ellipse x:Name="RecordingDot" Width="9" Height="9" Fill="#D32F2F" Margin="0,0,7,0" VerticalAlignment="Center" />
            <views:AnnouncedText x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Rappel arrivé à son heure (Paramètres › Rappels pendant l'intervention) : reste affiché jusqu'à « Vu », noté
             au journal. Jamais de focus déplacé : la frappe en cours ne part pas ailleurs. -->
        <Border x:Name="ReminderBanner" DockPanel.Dock="Top" Style="{StaticResource WarningBanner}" Margin="0,0,0,10" Visibility="Collapsed">
            <DockPanel>
                <Button x:Name="ReminderSeenButton" DockPanel.Dock="Right" Click="OnReminderSeen" Margin="8,0,0,0" VerticalAlignment="Center"
                        MinWidth="0" Padding="10,1" ToolTip="{x:Static loc:Strings.InterventionReminderSeenTip}"
                        AutomationProperties.HelpText="{x:Static loc:Strings.InterventionReminderSeenTip}">
                    <AccessText Text="{x:Static loc:Strings.InterventionReminderSeen}" />
                </Button>
                <views:AnnouncedText x:Name="ReminderText" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center"
                                     Foreground="{DynamicResource WarningBrush}" AutomationProperties.LiveSetting="Assertive" />
            </DockPanel>
        </Border>

        <Label DockPanel.Dock="Top" Target="{Binding ElementName=TitleBox}" Padding="0,0,0,3" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
               Content="{x:Static loc:Strings.InterventionTitleLabel}" />
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBox x:Name="TitleBox" MaxLength="200" KeyDown="OnTitleKeyDown" LostKeyboardFocus="OnTitleLostFocus" />
            <TextBlock Style="{StaticResource Placeholder}" Tag="{Binding ElementName=TitleBox}"
                       Text="{x:Static loc:Strings.InterventionTitlePlaceholder}" Margin="6,0,0,0" />
        </Grid>

        <Label DockPanel.Dock="Top" Target="{Binding ElementName=NoteBox}" Padding="0,0,0,3" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
               Content="{x:Static loc:Strings.InterventionNoteLabel}" />
        <!-- Modification d'une note de l'historique : le champ de la note reprend son texte. -->
        <views:AnnouncedText x:Name="EditingText" DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"
                             Margin="0,0,0,3" Visibility="Collapsed" />
        <Grid DockPanel.Dock="Top">
            <TextBox x:Name="NoteBox" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" Height="58"
                     VerticalScrollBarVisibility="Auto" PreviewKeyDown="OnNotePreviewKeyDown" TextChanged="OnNoteChanged"
                     AutomationProperties.HelpText="{x:Static loc:Strings.InterventionNoteKeys}" />
            <TextBlock Style="{StaticResource Placeholder}" Tag="{Binding ElementName=NoteBox}" VerticalAlignment="Top"
                       Text="{x:Static loc:Strings.InterventionNotePlaceholder}" Margin="6,4,0,0" />
        </Grid>
        <TextBlock DockPanel.Dock="Top" Text="{x:Static loc:Strings.InterventionNoteKeys}" Foreground="{DynamicResource MutedBrush}"
                   TextWrapping="Wrap" Margin="0,3,0,6" />
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button x:Name="NoteButton" Click="OnAddNote" Margin="0,0,8,4">
                <AccessText x:Name="NoteButtonText" Text="{x:Static loc:Strings.InterventionAddNote}" />
            </Button>
            <Button x:Name="CancelEditButton" Click="OnCancelEdit" Margin="0,0,8,4" Visibility="Collapsed">
                <AccessText Text="{x:Static loc:Strings.InterventionCancelNoteEdit}" />
            </Button>
            <Button x:Name="CaptureButton" Click="OnCapture" Margin="0,0,0,4" ToolTip="{x:Static loc:Strings.InterventionCaptureTip}"
                    AutomationProperties.HelpText="{x:Static loc:Strings.InterventionCaptureTip}">
                <AccessText Text="{x:Static loc:Strings.InterventionCaptureRdp}" />
            </Button>
        </WrapPanel>

        <TextBlock x:Name="HistoryTitle" DockPanel.Dock="Top" Text="{x:Static loc:Strings.InterventionHistorySection}"
                   Style="{StaticResource SectionTitle}" />
        <TextBlock x:Name="CappedText" DockPanel.Dock="Bottom" Text="{x:Static loc:Strings.InterventionHistoryCapped}" TextWrapping="Wrap"
                   Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0" Visibility="Collapsed" />
        <!-- Journal au-delà de 100 Mo : l'écran des Bureaux à distance n'est plus gardé qu'une fois toutes les 10 s. -->
        <TextBlock x:Name="ScreenThrottledText" DockPanel.Dock="Bottom" Text="{x:Static loc:Strings.InterventionScreenThrottled}" TextWrapping="Wrap"
                   Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0" Visibility="Collapsed" />
        <!-- Historique : un bloc par événement, ou par commande d'un terminal et son retour ; un long bloc se déplie. -->
        <ListBox x:Name="HistoryList" AutomationProperties.LabeledBy="{Binding ElementName=HistoryTitle}" PreviewKeyDown="OnHistoryKeyDown"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.CommandBindings>
                <CommandBinding Command="ApplicationCommands.Copy" Executed="OnCopy" CanExecute="OnCanCopy" />
            </ListBox.CommandBindings>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName, Mode=OneWay}" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type views:InterventionHistoryItem}">
                    <StackPanel Margin="0,3,0,5">
                        <DockPanel>
                            <!-- Note de l'enregistrement en cours : modifiable (F2), le journal garde le texte d'origine. -->
                            <Button x:Name="EditNote" DockPanel.Dock="Right" Content="{x:Static loc:Strings.InterventionEditNote}" Click="OnEditNote"
                                    ToolTip="{x:Static loc:Strings.InterventionEditNoteTip}" AutomationProperties.HelpText="{x:Static loc:Strings.InterventionEditNoteTip}"
                                    MinWidth="0" Padding="8,0" Margin="6,0,0,0" VerticalAlignment="Top" Visibility="Collapsed"
                                    IsEnabled="{Binding NotesEditable, RelativeSource={RelativeSource AncestorType=views:InterventionPanel}}" />
                            <TextBlock Text="{Binding Time, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Kind, Mode=OneWay}" FontWeight="SemiBold" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Edited, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" FontStyle="Italic" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Source, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <Border x:Name="Body" Margin="0,2,0,0">
                            <TextBlock x:Name="Preview" Text="{Binding Preview, Mode=OneWay}" TextWrapping="Wrap" />
                        </Border>
                        <TextBox x:Name="Full" Style="{StaticResource CodeBox}" Text="{Binding FullText, Mode=OneWay}" MaxHeight="320"
                                 VerticalScrollBarVisibility="Auto" Margin="0,2,0,0" Visibility="Collapsed"
                                 AutomationProperties.Name="{Binding Kind, Mode=OneWay}" />
                        <Button x:Name="Toggle" Content="{Binding ToggleText, Mode=OneWay}" Click="OnToggle" HorizontalAlignment="Left"
                                Margin="0,3,0,0" Padding="6,1" Visibility="Collapsed" />
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsTerminal, Mode=OneWay}" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource CodeBrush}" />
                            <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource CodeBorderBrush}" />
                            <Setter TargetName="Body" Property="BorderThickness" Value="1" />
                            <Setter TargetName="Body" Property="Padding" Value="6,3" />
                            <Setter TargetName="Preview" Property="FontFamily" Value="Consolas, Courier New" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsNote, Mode=OneWay}" Value="True">
                            <Setter TargetName="EditNote" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLong, Mode=OneWay}" Value="True">
                            <Setter TargetName="Toggle" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsExpanded, Mode=OneWay}" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Full" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
