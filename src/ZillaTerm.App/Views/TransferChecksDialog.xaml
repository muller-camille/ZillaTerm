<Window x:Class="ZillaTerm.App.Views.TransferChecksDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ZillaTerm.App.Views"
        xmlns:loc="clr-namespace:ZillaTerm.App.Localization"
        Title="{x:Static loc:Strings.ChecksTitle}" Width="1240" Height="460" MinWidth="640" MinHeight="260"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="HashText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <!-- Vert si identique, rouge si différent, orange si non vérifié. -->
        <Style x:Key="ResultText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Matches}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Matches}" Value="False" />
                        <Condition Binding="{Binding Verified}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </MultiDataTrigger>
                <!-- Ligne sélectionnée : couleur du texte de la sélection, la seule lisible sur son fond (le texte dit le résultat). -->
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridCell}}" Value="True">
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <TextBlock x:Name="HeadingText" DockPanel.Dock="Top" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,4" />
        <TextBlock x:Name="IntroText" DockPanel.Dock="Top" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{x:Static loc:Strings.ChecksCopy}" ToolTip="{x:Static loc:Strings.ChecksCopyTip}" Click="OnCopy" />
                <Button Content="{x:Static loc:Strings.CloseButton}" IsCancel="True" IsDefault="True" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock x:Name="CopiedText" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
        </DockPanel>

        <DataGrid x:Name="ChecksGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource GridLineBrush}" AlternatingRowBackground="{DynamicResource AlternateRowBrush}" ClipboardCopyMode="IncludeHeader" />
    </DockPanel>
</Window>
