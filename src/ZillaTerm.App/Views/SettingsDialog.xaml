<Window x:Class="ZillaTerm.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ZillaTerm.App.Views"
        xmlns:loc="clr-namespace:ZillaTerm.App.Localization"
        xmlns:core="clr-namespace:ZillaTerm.Core;assembly=ZillaTerm.Core"
        Title="{x:Static loc:Strings.SettingsTitle}"
        Width="820" Height="620" MinWidth="680" MinHeight="460" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- Une page par tâche (onglets à gauche, Ctrl+Tab de l'une à l'autre), chacune tenant sur un écran. Une même mise en
         page partout : titre de section, case ou champ, une ligne d'aide dessous ; « ⚠ » pour un vrai risque ; pastille
         « Équipe » à droite d'un réglage que le fichier d'environnement de l'équipe définit. Tout s'applique avec
         « Enregistrer » (un environnement importé compris), sauf les actions du coffre local, qui le disent. Le détail
         est dans le guide : « En savoir plus » (F1) ouvre la section de la page affichée (ancre « settings-<Tag> »). -->
    <Window.Resources>
        <Style x:Key="Page" TargetType="StackPanel">
            <Setter Property="Margin" Value="20,14,22,18" />
            <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        </Style>
        <Style x:Key="FirstSection" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Setter Property="Margin" Value="0,20,0,2" />
        </Style>
        <Style x:Key="SubTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Ligne d'une case : la pastille « Équipe » à droite, la case prend le reste (son texte passe à la ligne). -->
        <Style x:Key="OptionRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style x:Key="Help" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="20,2,0,0" />
        </Style>
        <Style x:Key="Warn" TargetType="TextBlock" BasedOn="{StaticResource Help}">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        </Style>
        <Style x:Key="FieldHelp" TargetType="TextBlock" BasedOn="{StaticResource Help}">
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <!-- Ligne d'un champ : libellé (colonne commune à la page), champ, bouton éventuel, pastille ; aide dessous. -->
        <Style x:Key="FieldRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
            <Setter Property="Padding" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="{x:Static loc:Strings.Save}" IsDefault="True" Click="OnSave" />
                    <Button Content="{x:Static loc:Strings.Cancel}" IsCancel="True" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Hyperlink x:Name="GuideHyperlink" Click="OnGuide" ToolTip="{x:Static loc:Strings.SettingsGuideTip}" Foreground="{DynamicResource AccentBrush}"
                               AutomationProperties.HelpText="{x:Static loc:Strings.SettingsGuideTip}">
                        <Run Text="{x:Static loc:Strings.SettingsGuide}" />
                    </Hyperlink>
                </TextBlock>
                <views:ErrorLine x:Name="ErrorText" Visibility="Collapsed" Margin="0,0,16,0" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <TabControl x:Name="Pages" TabStripPlacement="Left" Margin="10,10,10,8" Padding="0">
            <TabControl.Resources>
                <!-- Sur le style du thème (clair ou sombre) en vigueur à l'ouverture de la fenêtre. -->
                <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                    <Setter Property="Padding" Value="14,7" />
                    <Setter Property="MinWidth" Value="150" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                </Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                    <Setter Property="Focusable" Value="False" />
                </Style>
            </TabControl.Resources>

            <!-- ===== Général ===== -->
            <TabItem x:Name="GeneralPage" Tag="general" Header="{x:Static loc:Strings.SettingsPageGeneral}">
                <ScrollViewer>
                    <StackPanel Style="{StaticResource Page}">
                        <TextBlock Text="{x:Static loc:Strings.SettingsSectionDisplay}" Style="{StaticResource FirstSection}" />
                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" MinWidth="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Content="{x:Static loc:Strings.LanguageLabel}" Target="{Binding ElementName=LanguageBox}" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Column="1" x:Name="LanguageBox" MaxWidth="320" HorizontalAlignment="Left" MinWidth="220" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldHelp}" Text="{x:Static loc:Strings.LanguageHelp}" />
                        </Grid>
                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" MinWidth="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Content="{x:Static loc:Strings.AppThemeLabel}" Target="{Binding ElementName=AppThemeBox}" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Column="1" x:Name="AppThemeBox" MaxWidth="320" HorizontalAlignment="Left" MinWidth="220" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldHelp}" Text="{x:Static loc:Strings.AppThemeHelp}" />
                        </Grid>

                        <TextBlock Text="{x:Static loc:Strings.SettingsSectionSessions}" Style="{StaticResource Section}" />
                        <DockPanel Style="{StaticResource OptionRow}">
                            <CheckBox x:Name="ConfirmCloseBox">
                                <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.SettingsConfirmClose}" />
                            </CheckBox>
                        </DockPanel>

                        <!-- Environnement d'équipe : fichier central relu à chaque démarrage (voir EnvironmentImport). -->
                        <TextBlock Text="{x:Static loc:Strings.SettingsSectionTeam}" Style="{StaticResource Section}" />
                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" MinWidth="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Content="{x:Static loc:Strings.CentralFileLabel}" Target="{Binding ElementName=CentralFileBox}" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" x:Name="CentralFileBox" VerticalContentAlignment="Center" />
                            <Button Grid.Column="2" Content="{x:Static loc:Strings.Browse}" Click="OnBrowseCentralFile" Margin="8,0,0,0" />
                            <views:TeamBadge Grid.Column="3" Setting="CentralFile" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource FieldHelp}" Text="{x:Static loc:Strings.CentralFileHelp}" />
                            <!-- Fichier importé : repris dans les pages, appliqué à « Enregistrer » ; exporté : les valeurs affichées. -->
                            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="ImportEnvButton" Click="OnImportEnvironment">
                                    <AccessText Text="{x:Static loc:Strings.SettingsEnvImport}" />
                                </Button>
                                <Button x:Name="ExportEnvButton" Click="OnExportEnvironment" Margin="8,0,0,0">
                                    <AccessText Text="{x:Static loc:Strings.SettingsEnvExport}" />
                                </Button>
                            </StackPanel>
                            <views:AnnouncedText Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" x:Name="EnvironmentText" Style="{StaticResource FieldHelp}"
                                                 Text="{x:Static loc:Strings.SettingsEnvHelp}" AutomationProperties.LiveSetting="Polite" />
                        </Grid>

                        <TextBlock Text="{x:Static loc:Strings.SettingsSectionTroubleshooting}" Style="{StaticResource Section}" />
                        <DockPanel Style="{StaticResource OptionRow}">
                            <CheckBox x:Name="DebugLogBox" VerticalAlignment="Center">
                                <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.SettingsDebugLog}" />
                            </CheckBox>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Help}" Text="{x:Static loc:Strings.SettingsDebugLogHelp}" />
                        <!-- Juste sous la case : le fichier du journal dans l'Explorateur (journal actif ou non, s'il existe). -->
                        <Button x:Name="DebugLogShowButton" Click="OnShowDebugLog" HorizontalAlignment="Left" Margin="20,6,0,0"
                                ToolTip="{x:Static loc:Strings.SettingsDebugLogShowTip}" AutomationProperties.HelpText="{x:Static loc:Strings.SettingsDebugLogShowTip}">
                            <AccessText Text="{x:Static loc:Strings.SettingsDebugLogShow}" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== CyberArk ===== -->
            <TabItem x:Name="CyberArkPage" Tag="cyberark" Header="{x:Static loc:Strings.SettingsPageCyberArk}">
                <ScrollViewer>
                    <StackPanel Style="{StaticResource Page}">
                        <TextBlock Text="{x:Static loc:Strings.PvwaSessionSection}" Style="{StaticResource FirstSection}" />
                        <DockPanel Style="{StaticResource OptionRow}">
                            <views:TeamBadge DockPanel.Dock="Right" Setting="KeepPvwaSessionAlive" />
                            <CheckBox x:Name="KeepAliveBox">
                                <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.KeepAlive}" />
                            </CheckBox>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Help}" Text="{x:Static loc:Strings.KeepAliveHelp}" />
                        <DockPanel Style="{StaticResource OptionRow}">
                            <views:TeamBadge DockPanel.Dock="Right" Setting="KeepAccountListCopy" />
                            <CheckBox x:Name="KeepAccountListCopyBox">
                                <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.KeepAccountListCopy}" />
                            </CheckBox>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Help}" Text="{x:Static loc:Strings.KeepAccountListCopyHelp}" />

                        <TextBlock Text="{x:Static loc:Strings.ComponentsSection}" Style="{StaticResource Section}" />
                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" MinWidth="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Content="{x:Static loc:Strings.WindowsComponentLabel}" Target="{Binding ElementName=WindowsComponentBox}" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Column="1" x:Name="WindowsComponentBox" IsEditable="True" MaxWidth="320" HorizontalAlignment="Left" MinWidth="220" />
                            <views:TeamBadge Grid.Column="2" Setting="WindowsComponent" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FieldHelp}" Text="{x:Static loc:Strings.WindowsComponentHelp}" />
                        </Grid>
                        <!-- Composant par plateforme : prioritaire sur celui des comptes Windows (voir AppSettings.ResolveComponent). -->
                        <DockPanel Margin="0,16,0,0">
                            <views:TeamBadge DockPanel.Dock="Right" Setting="PlatformComponent" />
                            <TextBlock Text="{x:Static loc:Strings.PlatformComponentsSection}" Style="{StaticResource SubTitle}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource FieldHelp}" Margin="0,2,0,6" Text="{x:Static loc:Strings.PlatformComponentsHelp}" />
                        <DataGrid x:Name="ComponentGrid" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False"
                                  CanUserDeleteRows="False" CanUserReorderColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource GridLineBrush}"
                                  MinHeight="60" MaxHeight="180" SelectionChanged="OnComponentSelected"
                                  AutomationProperties.Name="{x:Static loc:Strings.PlatformComponentsSection}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{x:Static loc:Strings.ComponentColumnPlatform}" Width="*"
                                                    Binding="{Binding Platform, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="{x:Static loc:Strings.ComponentColumnComponent}" Width="*"
                                                    Binding="{Binding Component, UpdateSourceTrigger=PropertyChanged}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="{x:Static loc:Strings.ComponentAdd}" Click="OnAddComponent" />
                            <Button x:Name="RemoveComponentButton" Content="{x:Static loc:Strings.ComponentRemove}" Click="OnRemoveComponent"
                                    IsEnabled="False" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== SSH ===== -->
            <TabItem x:Name="SshPage" Tag="ssh" Header="{x:Static loc:Strings.SettingsPageSsh}">
                <ScrollViewer>
                    <StackPanel Style="{StaticResource Page}">
                        <DockPanel Margin="0">
                            <views:TeamBadge DockPanel.Dock="Right" Setting="SshInApp" />
                            <CheckBox x:Name="SshInAppBox">
                                <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.SshInApp}" />
                            </CheckBox>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Help}" Text="{x:Static loc:Strings.SshInAppHelp}" />

                        <TextBlock Text="{x:Static loc:Strings.SettingsSshSection}" Style="{StaticResource Section}" />
                        <TextBlock Style="{StaticResource FieldHelp}" Margin="0" Text="{x:Static loc:Strings.SettingsSshHelp}" />
                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" MinWidth="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Content="{x:Static loc:Strings.PsmpAddressLabel}" Target="{Binding ElementName=PsmpBox}" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" x:Name="PsmpBox" VerticalContentAlignment="Center" TextChanged="OnPsmpChanged" />
                            <Label Grid.Column="2" Content="{x:Static loc:Strings.PortLabel}" Target="{Binding ElementName=PortBox}" Style="{StaticResource FieldLabel}"
                                   Margin="12,0,0,0" />
                            <TextBox Grid.Column="3" x:Name="PortBox" VerticalContentAlignment="Center" TextChanged="OnPsmpChanged" />
                            <views:TeamBadge Grid.Column="4" Setting="DefaultPsmp" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Style="{StaticResource FieldHelp}" Text="{x:Static loc:Strings.PsmpDefaultHelp}" />
                        </Grid>
                        <!-- Autres PSMP : chaque serveur passe par celui de son domaine le plus proche (voir PsmpRouting). -->
                        <DockPanel Margin="0,16,0,0">
                            <views:TeamBadge DockPanel.Dock="Right" Setting="PsmpServers" />
                            <TextBlock Text="{x:Static loc:Strings.PsmpListSection}" Style="{StaticResource SubTitle}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource FieldHelp}" Margin="0,2,0,6" Text="{x:Static loc:Strings.PsmpListHelp}" />
                        <DataGrid x:Name="PsmpGrid" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False"
                                  CanUserDeleteRows="False" CanUserReorderColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource GridLineBrush}"
                                  MinHeight="80" MaxHeight="180" SelectionChanged="OnPsmpSelected"
                                  AutomationProperties.Name="{x:Static loc:Strings.PsmpListSection}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{x:Static loc:Strings.PsmpColumnAddress}" Width="2*"
                                                    Binding="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="{x:Static loc:Strings.PsmpColumnPort}" Width="60"
                                                    Binding="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="{x:Static loc:Strings.PsmpColumnDomain}" Width="2*"
                                                    Binding="{Binding Domain, UpdateSourceTrigger=PropertyChanged}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="{x:Static loc:Strings.PsmpAdd}" Click="OnAddPsmp" />
                            <Button x:Name="RemovePsmpButton" Content="{x:Static loc:Strings.PsmpRemove}" Click="OnRemovePsmp"
                                    IsEnabled="False" Margin="8,0,0,0" />
                        </StackPanel>
                        <Grid Style="{StaticResource FieldRow}" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" MinWidth="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Content="{x:Static loc:Strings.PsmpTestLabel}" Target="{Binding ElementName=PsmpTestBox}" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" x:Name="PsmpTestBox" VerticalContentAlignment="Center" TextChanged="OnPsmpChanged" />
                            <views:AnnouncedText Grid.Row="1" Grid.Column="1" x:Name="PsmpTestText" Style="{StaticResource FieldHelp}"
                                                 AutomationProperties.LiveSetting="Polite" />
                        </Grid>
                        <TextBlock Style="{StaticResource Warn}" Margin="0,10,0,0" Text="{x:Static loc:Strings.PsmpSecurityEffect}" />

                        <TextBlock Text="{x:Static loc:Strings.SettingsSectionShell}" Style="{StaticResource Section}" />
                        <DockPanel Style="{StaticResource OptionRow}">
                            <CheckBox x:Name="FollowBox">
                                <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.FollowSetting}" />
                            </CheckBox>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Help}" Text="{x:Static loc:Strings.SettingsFollowEffect}" />

                        <TextBlock Text="{x:Static loc:Strings.X11Section}" Style="{StaticResource Section}" />
                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" MinWidth="150" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Content="{x:Static loc:Strings.X11DisplayLabel}" Target="{Binding ElementName=X11DisplayBox}" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" x:Name="X11DisplayBox" VerticalContentAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FieldHelp}" Text="{x:Static loc:Strings.X11DisplayHelp}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Bureau à distance ===== -->
            <TabItem x:Name="RdpPage" Tag="rdp" Header="{x:Static loc:Strings.SettingsPageRdp}">
                <ScrollViewer>
                    <StackPanel Style="{StaticResource Page}">
                        <TextBlock Style="{StaticResource FieldHelp}" Margin="0" Text="{x:Static loc:Strings.SettingsRdpIntro}" />
                        <DockPanel Style="{StaticResource OptionRow}" Margin="0,12,0,0">
                            <views:TeamBadge DockPanel.Dock="Right" Setting="PsmDesktopInTab" />
                            <CheckBox x:Name="PsmDesktopInTabBox">
                                <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.PsmDesktopInTab}" />
                            </CheckBox>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Help}" Text="{x:Static loc:Strings.PsmDesktopInTabHelp}" />
                        <DockPanel Style="{StaticResource OptionRow}" Margin="20,8,0,0">
                            <CheckBox x:Name="PsmDynamicResolutionBox" IsEnabled="{Binding IsChecked, ElementName=PsmDesktopInTabBox}">
                                <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.PsmDynamicResolution}" />
                            </CheckBox>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Help}" Margin="40,2,0,0" Text="{x:Static loc:Strings.PsmDynamicResolutionHelp}" />
                        <!-- Disques du poste (onglet et Connexion Bureau à distance) : aucun, tous, ou les dossiers choisis (client
                             FreeRDP seulement ; aucun disque pour Connexion Bureau à distance et le contrôle de Windows). -->
                        <DockPanel Margin="0,16,0,0">
                            <views:TeamBadge DockPanel.Dock="Right" Setting="PsmRedirectDrives" />
                            <TextBlock x:Name="DrivesTitle" Text="{x:Static loc:Strings.PsmDrivesSection}" Style="{StaticResource SubTitle}" />
                        </DockPanel>
                        <RadioButton x:Name="DrivesNoneRadio" GroupName="Drives" Margin="0,6,0,0"
                                     AutomationProperties.HelpText="{x:Static loc:Strings.PsmDrivesSection}">
                            <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.PsmDrivesNone}" />
                        </RadioButton>
                        <RadioButton x:Name="DrivesAllRadio" GroupName="Drives" Margin="0,4,0,0"
                                     AutomationProperties.HelpText="{x:Static loc:Strings.PsmDrivesSection}">
                            <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.PsmDrivesAll}" />
                        </RadioButton>
                        <DockPanel Margin="0,4,0,0">
                            <views:TeamBadge DockPanel.Dock="Right" Setting="PsmShareFoldersOnly" />
                            <RadioButton x:Name="DrivesFoldersRadio" GroupName="Drives"
                                         AutomationProperties.HelpText="{x:Static loc:Strings.PsmDrivesSection}">
                                <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.PsmDrivesFolders}" />
                            </RadioButton>
                        </DockPanel>
                        <StackPanel x:Name="FoldersPanel" Margin="20,6,0,0" IsEnabled="{Binding IsChecked, ElementName=DrivesFoldersRadio}">
                            <DockPanel>
                                <views:TeamBadge DockPanel.Dock="Right" Setting="PsmSharedFolders" />
                                <TextBlock Style="{StaticResource FieldHelp}" Margin="0,0,0,6" Text="{x:Static loc:Strings.PsmFoldersHelp}" />
                            </DockPanel>
                            <DataGrid x:Name="FolderGrid" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False"
                                      CanUserDeleteRows="False" CanUserReorderColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource GridLineBrush}"
                                      MinHeight="70" MaxHeight="150" SelectionChanged="OnFolderSelected"
                                      AutomationProperties.Name="{x:Static loc:Strings.PsmFoldersList}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{x:Static loc:Strings.PsmFolderColName}" Width="*"
                                                        Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Header="{x:Static loc:Strings.PsmFolderColPath}" Width="2*"
                                                        Binding="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="{x:Static loc:Strings.PsmFolderAdd}" Click="OnAddFolder" />
                                <Button x:Name="RemoveFolderButton" Content="{x:Static loc:Strings.PsmFolderRemove}" Click="OnRemoveFolder"
                                        IsEnabled="False" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Warn}" Margin="0,8,0,0" Text="{x:Static loc:Strings.PsmRedirectDrivesHelp}" />
                        <!-- Toute session Bureau à distance dans un onglet (PSM, KeePass) avec le client FreeRDP : jamais grisée. -->
                        <DockPanel Style="{StaticResource OptionRow}" Margin="0,14,0,0">
                            <views:TeamBadge DockPanel.Dock="Right" Setting="PauseRdpDisplay" />
                            <CheckBox x:Name="PauseRdpDisplayBox">
                                <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.PauseRdpDisplay}" />
                            </CheckBox>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Help}" Text="{x:Static loc:Strings.PauseRdpDisplayHelp}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Terminal ===== -->
            <TabItem x:Name="TerminalPage" Tag="terminal" Header="{x:Static loc:Strings.SettingsPageTerminal}">
                <ScrollViewer>
                    <StackPanel Style="{StaticResource Page}">
                        <TextBlock Text="{x:Static loc:Strings.SettingsSectionTerminalDisplay}" Style="{StaticResource FirstSection}" />
                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" MinWidth="150" />
                                <ColumnDefinition Width="*" MaxWidth="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Content="{x:Static loc:Strings.TerminalThemeLabel}" Target="{Binding ElementName=ThemeBox}" Style="{StaticResource FieldLabel}" />
                            <ComboBox Grid.Column="1" x:Name="ThemeBox" />
                        </Grid>
                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" MinWidth="150" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Content="{x:Static loc:Strings.TerminalFontLabel}" Target="{Binding ElementName=FontSizeBox}" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" x:Name="FontSizeBox" VerticalContentAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FieldHelp}" Text="{x:Static loc:Strings.TerminalFontHelp}" />
                        </Grid>

                        <TextBlock Text="{x:Static loc:Strings.SettingsSectionTerminalInput}" Style="{StaticResource Section}" />
                        <DockPanel Style="{StaticResource OptionRow}">
                            <CheckBox x:Name="ConfirmPasteBox">
                                <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.SettingsConfirmPaste}" />
                            </CheckBox>
                        </DockPanel>
                        <DockPanel Style="{StaticResource OptionRow}">
                            <CheckBox x:Name="RightClickBox">
                                <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.SettingsRightClickPastes}" />
                            </CheckBox>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Warn}" Text="{x:Static loc:Strings.SettingsRightClickEffect}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Fichiers ===== -->
            <TabItem x:Name="FilesPage" Tag="files" Header="{x:Static loc:Strings.SettingsPageFiles}">
                <ScrollViewer>
                    <StackPanel Style="{StaticResource Page}">
                        <TextBlock Text="{x:Static loc:Strings.SettingsSectionTransfers}" Style="{StaticResource FirstSection}" />
                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" MinWidth="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label x:Name="UploadLabel" Content="{x:Static loc:Strings.UploadLabel}" Target="{Binding ElementName=SftpRadio}" Style="{StaticResource FieldLabel}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="SftpRadio" Content="SFTP" GroupName="Upload" Margin="0,0,20,0" VerticalAlignment="Center"
                                             AutomationProperties.LabeledBy="{Binding ElementName=UploadLabel}" />
                                <RadioButton x:Name="ScpRadio" Content="SCP" GroupName="Upload" VerticalAlignment="Center"
                                             AutomationProperties.LabeledBy="{Binding ElementName=UploadLabel}" />
                            </StackPanel>
                            <views:TeamBadge Grid.Column="2" Setting="UploadProtocol" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FieldHelp}" Text="{x:Static loc:Strings.UploadProtocolHelp}" />
                        </Grid>
                        <WrapPanel Margin="0,12,0,0">
                            <CheckBox x:Name="ArchiveBox" VerticalAlignment="Center">
                                <AccessText Text="{x:Static loc:Strings.SettingsArchiveOffer}" />
                            </CheckBox>
                            <TextBox x:Name="ArchiveThresholdBox" Width="60" Margin="6,0,6,0" VerticalAlignment="Center"
                                     IsEnabled="{Binding IsChecked, ElementName=ArchiveBox}" AutomationProperties.Name="{x:Static loc:Strings.A11yArchiveThreshold}" />
                            <TextBlock Text="{x:Static loc:Strings.SettingsArchiveFiles}" VerticalAlignment="Center" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Help}" Text="{x:Static loc:Strings.SettingsArchiveHelp}" />

                        <!-- Affichage de l'onglet Fichiers : aussi sur place (case « Cachés », clic droit sur l'en-tête des colonnes). -->
                        <TextBlock Text="{x:Static loc:Strings.SettingsSectionFilesTab}" Style="{StaticResource Section}" />
                        <DockPanel Style="{StaticResource OptionRow}">
                            <CheckBox x:Name="ShowHiddenBox">
                                <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.SettingsShowHidden}" />
                            </CheckBox>
                        </DockPanel>
                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" MinWidth="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Content="{x:Static loc:Strings.SettingsFileColumns}" Target="{Binding ElementName=SizeColumnBox}"
                                   Style="{StaticResource FieldLabel}" />
                            <WrapPanel Grid.Column="1">
                                <WrapPanel.Resources>
                                    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                        <Setter Property="Margin" Value="0,2,18,2" />
                                    </Style>
                                </WrapPanel.Resources>
                                <CheckBox x:Name="SizeColumnBox" Content="{x:Static loc:Strings.ColumnSize}" />
                                <CheckBox x:Name="ModifiedColumnBox" Content="{x:Static loc:Strings.ColumnModified}" />
                                <CheckBox x:Name="PermissionsColumnBox" Content="{x:Static loc:Strings.ColumnPermissions}" />
                                <CheckBox x:Name="OwnerColumnBox" Content="{x:Static loc:Strings.ColumnOwner}" />
                                <CheckBox x:Name="GroupColumnBox" Content="{x:Static loc:Strings.ColumnGroup}" />
                            </WrapPanel>
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldHelp}" Text="{x:Static loc:Strings.SettingsFilesTabHelp}" />
                        </Grid>

                        <!-- Suivi d'un fichier (tail -f) : options communes à toutes les fenêtres tail -f, aussi dans leur barre. -->
                        <TextBlock Text="{x:Static loc:Strings.SettingsSectionTail}" Style="{StaticResource Section}" />
                        <DockPanel Style="{StaticResource OptionRow}">
                            <CheckBox x:Name="TailSessionBox">
                                <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.SettingsTailSession}" />
                            </CheckBox>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Help}" Text="{x:Static loc:Strings.SettingsTailSessionHelp}" />
                        <DockPanel Style="{StaticResource OptionRow}">
                            <CheckBox x:Name="TailColorsBox">
                                <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.SettingsTailColors}" />
                            </CheckBox>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Help}" Text="{x:Static loc:Strings.TailColorsTip}" />
                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" MinWidth="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Content="{x:Static loc:Strings.SettingsTailHighlight}" Target="{Binding ElementName=TailHighlightBox}" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" x:Name="TailHighlightBox" VerticalContentAlignment="Center" MaxLength="1000" />
                            <Label Grid.Row="1" Content="{x:Static loc:Strings.SettingsTailAlert}" Target="{Binding ElementName=TailAlertBox}" Style="{StaticResource FieldLabel}"
                                   Margin="0,8,0,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TailAlertBox" VerticalContentAlignment="Center" MaxLength="1000" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldHelp}" Text="{x:Static loc:Strings.SettingsTailWordsHelp}" />
                        </Grid>
                        <DockPanel Style="{StaticResource OptionRow}">
                            <CheckBox x:Name="TailNotifyBox">
                                <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.SettingsTailNotify}" />
                            </CheckBox>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Help}" Text="{x:Static loc:Strings.SettingsTailNotifyHelp}" />

                        <TextBlock Text="{x:Static loc:Strings.SettingsSectionPrograms}" Style="{StaticResource Section}" />
                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" MinWidth="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Content="{x:Static loc:Strings.TextEditorLabel}" Target="{Binding ElementName=EditorBox}" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" x:Name="EditorBox" VerticalContentAlignment="Center" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Placeholder}" Tag="{Binding ElementName=EditorBox}"
                                       Text="notepad.exe" Margin="6,0,0,0" />
                            <Button Grid.Column="2" Content="{x:Static loc:Strings.Browse}" Click="OnBrowseEditor" Margin="8,0,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FieldHelp}" Text="{x:Static loc:Strings.TextEditorHelp}" />
                        </Grid>
                        <!-- Outil de comparaison externe (facultatif) : la comparaison intégrée suffit sinon. -->
                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" MinWidth="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Content="{x:Static loc:Strings.CompareToolLabel}" Target="{Binding ElementName=CompareToolBox}" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" x:Name="CompareToolBox" VerticalContentAlignment="Center" />
                            <Button Grid.Column="2" Content="{x:Static loc:Strings.BrowseOther}" Click="OnBrowseCompareTool" Margin="8,0,0,0" />
                            <Label Grid.Row="1" Content="{x:Static loc:Strings.CompareArgumentsLabel}" Target="{Binding ElementName=CompareArgsBox}"
                                   Style="{StaticResource FieldLabel}" Margin="0,6,0,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="CompareArgsBox" VerticalContentAlignment="Center" Margin="0,6,0,0"
                                     FontFamily="Consolas, Courier New" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FieldHelp}" Text="{x:Static loc:Strings.CompareToolHelp}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Mes serveurs ===== -->
            <TabItem x:Name="ServersPage" Tag="servers" Header="{x:Static loc:Strings.SettingsPageServers}">
                <DockPanel Margin="20,14,22,18">
                    <!-- Étiquettes des serveurs de « Mes serveurs » (PROD, QA, DEV…) : nom et couleur. -->
                    <DockPanel DockPanel.Dock="Top">
                        <views:TeamBadge DockPanel.Dock="Right" Setting="ServerTags" />
                        <TextBlock Text="{x:Static loc:Strings.ServerTagsSection}" Style="{StaticResource FirstSection}" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource FieldHelp}" Margin="0,0,0,8" Text="{x:Static loc:Strings.ServerTagsHelp}" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="AddTagButton" Click="OnAddTag" ToolTipService.ShowOnDisabled="True">
                            <AccessText Text="{x:Static loc:Strings.ServerTagAdd}" />
                        </Button>
                        <Button x:Name="RemoveTagButton" Click="OnRemoveTag" IsEnabled="False" Margin="8,0,0,0">
                            <AccessText Text="{x:Static loc:Strings.ServerTagRemove}" />
                        </Button>
                    </StackPanel>
                    <DataGrid x:Name="TagGrid" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False"
                              CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserSortColumns="False" SelectionMode="Single"
                              SelectionUnit="FullRow" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource GridLineBrush}"
                              MinHeight="60" SelectionChanged="OnTagSelected"
                              AutomationProperties.Name="{x:Static loc:Strings.ServerTagsSection}">
                        <DataGrid.Columns>
                            <!-- Aperçu : la pastille telle qu'elle apparaîtra sur l'onglet. -->
                            <DataGridTemplateColumn Width="Auto" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Background}" CornerRadius="3" Padding="5,0,5,1" Margin="4,2"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Foreground="{Binding Foreground}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{x:Static loc:Strings.ServerTagColName}" Width="*"
                                                Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Margin" Value="2,0" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="MaxLength" Value="{x:Static core:ServerTagRules.MaxNameLength}" />
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="{x:Static loc:Strings.ServerTagColColor}" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding Colors}" SelectedValuePath="Hex"
                                                  SelectedValue="{Binding Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  AutomationProperties.Name="{Binding ColorName}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Rectangle Width="14" Height="14" Fill="{Binding Brush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===== Intervention ===== -->
            <TabItem x:Name="InterventionPage" Tag="intervention" Header="{x:Static loc:Strings.SettingsPageIntervention}">
                <ScrollViewer>
                    <StackPanel Style="{StaticResource Page}">
                        <!-- Astreinte : consignes de l'équipe (texte ou fichier), diffusées par le fichier d'environnement. -->
                        <DockPanel>
                            <views:TeamBadge DockPanel.Dock="Right" Setting="DutyText" />
                            <TextBlock Text="{x:Static loc:Strings.DutySection}" Style="{StaticResource FirstSection}" />
                        </DockPanel>
                        <Label Content="{x:Static loc:Strings.DutyTextLabel}" Target="{Binding ElementName=DutyTextBox}" Padding="0,8,0,4" />
                        <TextBox x:Name="DutyTextBox" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" MinHeight="96" MaxHeight="220"
                                 VerticalScrollBarVisibility="Auto" MaxLength="8000" />
                        <TextBlock Style="{StaticResource FieldHelp}" Text="{x:Static loc:Strings.DutyTextHelp}" />
                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Label" MinWidth="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Content="{x:Static loc:Strings.DutyFileLabel}" Target="{Binding ElementName=DutyFileBox}" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Column="1" x:Name="DutyFileBox" VerticalContentAlignment="Center" MaxLength="1024" />
                            <Button Grid.Column="2" Content="{x:Static loc:Strings.Browse}" Click="OnBrowseDutyFile" Margin="8,0,0,0" />
                            <views:TeamBadge Grid.Column="3" Setting="DutyTextFile" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource FieldHelp}" Text="{x:Static loc:Strings.DutyFileHelp}" />
                        </Grid>

                        <!-- Rappels pendant l'intervention : une ligne par rappel, minutes depuis le début puis le texte. -->
                        <DockPanel Margin="0,20,0,0">
                            <views:TeamBadge DockPanel.Dock="Right" Setting="InterventionReminders" />
                            <TextBlock Text="{x:Static loc:Strings.SettingsSectionReminders}" Style="{StaticResource FirstSection}" />
                        </DockPanel>
                        <Label Content="{x:Static loc:Strings.RemindersLabel}" Target="{Binding ElementName=RemindersBox}" Padding="0,8,0,4" />
                        <TextBox x:Name="RemindersBox" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" MinHeight="58" MaxHeight="160"
                                 VerticalScrollBarVisibility="Auto" MaxLength="2400" FontFamily="Consolas, Courier New"
                                 AutomationProperties.HelpText="{x:Static loc:Strings.RemindersHelp}" />
                        <TextBlock Style="{StaticResource FieldHelp}" Text="{x:Static loc:Strings.RemindersHelp}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Partage de sessions ===== -->
            <TabItem x:Name="SharingPage" Tag="sharing" Header="{x:Static loc:Strings.SettingsPageSharing}">
                <ScrollViewer>
                    <StackPanel Style="{StaticResource Page}">
                        <DockPanel>
                            <views:TeamBadge DockPanel.Dock="Right" Setting="SessionSharing" />
                            <CheckBox x:Name="SessionSharingBox">
                                <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.SettingsSessionSharing}" />
                            </CheckBox>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Help}" Text="{x:Static loc:Strings.SettingsSessionSharingHelp}" />
                        <!-- Par où les autres rejoignent mes partages : directement, sinon par le dossier relais. -->
                        <StackPanel IsEnabled="{Binding IsChecked, ElementName=SessionSharingBox}" Grid.IsSharedSizeScope="True">
                            <TextBlock Text="{x:Static loc:Strings.SettingsSectionShareRoutes}" Style="{StaticResource Section}" />
                            <DockPanel Style="{StaticResource OptionRow}">
                                <views:TeamBadge DockPanel.Dock="Right" Setting="ShareDirect" />
                                <WrapPanel>
                                    <CheckBox x:Name="ShareDirectBox" VerticalAlignment="Center">
                                        <AccessText Text="{x:Static loc:Strings.SettingsShareDirect}" />
                                    </CheckBox>
                                    <Label Content="{x:Static loc:Strings.SettingsSharePort}" Target="{Binding ElementName=SharePortBox}" Margin="20,0,6,0"
                                           Padding="0" VerticalAlignment="Center" />
                                    <TextBox x:Name="SharePortBox" Width="70" VerticalAlignment="Center" MaxLength="5"
                                             IsEnabled="{Binding IsChecked, ElementName=ShareDirectBox}" />
                                </WrapPanel>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Help}" Text="{x:Static loc:Strings.SettingsShareDirectHelp}" />
                            <Grid Style="{StaticResource FieldRow}" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label" MinWidth="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Label Content="{x:Static loc:Strings.SettingsShareRelay}" Target="{Binding ElementName=ShareRelayBox}" Style="{StaticResource FieldLabel}" />
                                <TextBox Grid.Column="1" x:Name="ShareRelayBox" VerticalContentAlignment="Center" MaxLength="400" />
                                <Button Grid.Column="2" Content="{x:Static loc:Strings.Browse}" Click="OnBrowseShareRelay" Margin="8,0,0,0" />
                                <views:TeamBadge Grid.Column="3" Setting="ShareRelayFolder" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource FieldHelp}" Text="{x:Static loc:Strings.SettingsShareRelayHelp}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Sécurité ===== -->
            <TabItem x:Name="SecurityPage" Tag="security" Header="{x:Static loc:Strings.SettingsPageSecurity}">
                <DockPanel Margin="20,14,22,18">
                    <!-- Coffre local : actions immédiates, sans « Enregistrer », dans leur propre cadre. -->
                    <Border DockPanel.Dock="Bottom" Margin="0,18,0,0" Padding="12,10" BorderThickness="1" CornerRadius="3"
                            BorderBrush="{DynamicResource ToolbarBorderBrush}" Background="{DynamicResource SidePanelBrush}">
                        <StackPanel>
                            <TextBlock Text="{x:Static loc:Strings.LocalStoreSection}" Style="{StaticResource FirstSection}" />
                            <TextBlock x:Name="StoreText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,8" />
                            <WrapPanel>
                                <Button x:Name="StoreCreateButton" Content="{x:Static loc:Strings.LocalStoreCreate}" Click="OnStoreCreate" Margin="0,0,8,4" />
                                <Button x:Name="StoreUnlockButton" Content="{x:Static loc:Strings.LocalStoreUnlockMenu}" Click="OnStoreUnlock" Margin="0,0,8,4" />
                                <Button x:Name="StoreChangeButton" Content="{x:Static loc:Strings.LocalStoreChange}" Click="OnStoreChange" Margin="0,0,8,4" />
                                <Button x:Name="StoreDeleteButton" Content="{x:Static loc:Strings.LocalStoreDelete}" Click="OnStoreDelete" Margin="0,0,8,4"
                                        Style="{StaticResource DangerButton}" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource FieldHelp}" Text="{x:Static loc:Strings.LocalStoreImmediate}" />
                        </StackPanel>
                    </Border>

                    <!-- Clés de serveur acceptées : oubliées à l'enregistrement (la connexion suivante redemandera l'empreinte) ;
                         « Rétablir » les remet dans la liste d'ici là. -->
                    <DockPanel DockPanel.Dock="Top">
                        <views:TeamBadge DockPanel.Dock="Right" Setting="HostKey" />
                        <TextBlock Text="{x:Static loc:Strings.HostKeysSection}" Style="{StaticResource FirstSection}" />
                    </DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,8,0,6" MaxWidth="320" HorizontalAlignment="Left">
                        <TextBox x:Name="HostKeysFilterBox" MinWidth="260" VerticalContentAlignment="Center" TextChanged="OnHostKeysFilter"
                                 AutomationProperties.Name="{x:Static loc:Strings.HostKeysFilter}" />
                        <TextBlock Style="{StaticResource Placeholder}" Tag="{Binding ElementName=HostKeysFilterBox}"
                                   Text="{x:Static loc:Strings.HostKeysFilter}" Margin="6,0,0,0" />
                    </Grid>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <Button x:Name="ForgetKeysButton" DockPanel.Dock="Right" Content="{x:Static loc:Strings.ForgetSelectedKeys}"
                                Click="OnForgetHostKeys" IsEnabled="False" VerticalAlignment="Top" />
                        <Button x:Name="RestoreKeysButton" DockPanel.Dock="Right" Content="{x:Static loc:Strings.SettingsRestoreKeys}"
                                Click="OnRestoreHostKeys" Visibility="Collapsed" Margin="0,0,8,0" VerticalAlignment="Top" />
                        <TextBlock x:Name="HostKeysText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,12,0"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <DataGrid x:Name="HostKeysGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource GridLineBrush}"
                              SelectionMode="Extended" SelectionUnit="FullRow" CanUserAddRows="False" MinHeight="90"
                              SelectionChanged="OnHostKeySelected" AutomationProperties.Name="{x:Static loc:Strings.HostKeysSection}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{x:Static loc:Strings.HostKeyServer}" Binding="{Binding Server}" Width="2*" />
                            <DataGridTextColumn Header="{x:Static loc:Strings.HostKeyType}" Binding="{Binding Algorithm}" Width="*" />
                            <DataGridTextColumn Header="{x:Static loc:Strings.HostKeyFingerprint}" Binding="{Binding Fingerprint}" Width="3*"
                                                FontFamily="Consolas, Courier New" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <!-- ===== À propos ===== -->
            <TabItem x:Name="AboutPage" Tag="about" Header="{x:Static loc:Strings.SettingsPageAbout}">
                <ScrollViewer>
                    <StackPanel Style="{StaticResource Page}">
                        <views:AboutPanel x:Name="AboutView" />
                        <!-- Recherche automatique : à côté de la recherche à la demande. -->
                        <DockPanel Style="{StaticResource OptionRow}" Margin="0,10,0,0">
                            <views:TeamBadge DockPanel.Dock="Right" Setting="CheckForUpdates" />
                            <CheckBox x:Name="UpdateCheckBox">
                                <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.AboutAutoCheck}" />
                            </CheckBox>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Help}" Text="{x:Static loc:Strings.UpdateCheckHelp}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
