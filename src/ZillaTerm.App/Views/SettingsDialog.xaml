<Window x:Class="ZillaTerm.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ZillaTerm.App.Views"
        xmlns:loc="clr-namespace:ZillaTerm.App.Localization"
        xmlns:core="clr-namespace:ZillaTerm.Core;assembly=ZillaTerm.Core"
        Title="{x:Static loc:Strings.SettingsTitle}"
        Width="780" Height="560" MinWidth="640" MinHeight="420" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- Une page par thème (onglets à gauche, Ctrl+Tab de l'une à l'autre) ; chaque page défile si besoin. Les réglages
         s'appliquent avec « Enregistrer » ; seules les actions du coffre local sont immédiates, et le disent. -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="{x:Static loc:Strings.Save}" IsDefault="True" Click="OnSave" />
                    <Button Content="{x:Static loc:Strings.Cancel}" IsCancel="True" Margin="8,0,0,0" />
                </StackPanel>
                <views:ErrorLine x:Name="ErrorText" Visibility="Collapsed" Margin="0,0,16,0" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <TabControl x:Name="Pages" TabStripPlacement="Left" Margin="10,10,10,8" Padding="0">
            <TabControl.Resources>
                <!-- Sur le style du thème (clair ou sombre) en vigueur à l'ouverture de la fenêtre. -->
                <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                    <Setter Property="Padding" Value="14,7" />
                    <Setter Property="MinWidth" Value="130" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                </Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                    <Setter Property="Focusable" Value="False" />
                </Style>
            </TabControl.Resources>

            <!-- ===== Général ===== -->
            <TabItem x:Name="GeneralPage" Header="{x:Static loc:Strings.SettingsPageGeneral}">
                <ScrollViewer>
                    <StackPanel Margin="16,12">
                        <TextBlock Text="{x:Static loc:Strings.LanguageSection}" Style="{StaticResource SectionTitle}" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Content="{x:Static loc:Strings.LanguageLabel}" Target="{Binding ElementName=LanguageBox}" />
                            <ComboBox Grid.Column="1" x:Name="LanguageBox" VerticalAlignment="Center" MaxWidth="320" HorizontalAlignment="Left" MinWidth="220" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Static loc:Strings.LanguageHelp}" Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                        </Grid>

                        <TextBlock Text="{x:Static loc:Strings.AppearanceSection}" Style="{StaticResource SectionTitle}" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Content="{x:Static loc:Strings.AppThemeLabel}" Target="{Binding ElementName=AppThemeBox}" />
                            <ComboBox Grid.Column="1" x:Name="AppThemeBox" VerticalAlignment="Center" MaxWidth="320" HorizontalAlignment="Left" MinWidth="220" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Static loc:Strings.AppThemeHelp}" Foreground="{DynamicResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                        </Grid>

                        <TextBlock Text="{x:Static loc:Strings.SettingsUpdatesSection}" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="UpdateCheckBox" Margin="0,0,0,16">
                            <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.AboutAutoCheck}" />
                        </CheckBox>

                        <!-- Environnement d'équipe : fichier central relu à chaque démarrage (voir EnvironmentImport). -->
                        <TextBlock Text="{x:Static loc:Strings.EnvTitle}" Style="{StaticResource SectionTitle}" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label Content="{x:Static loc:Strings.CentralFileLabel}" Target="{Binding ElementName=CentralFileBox}" />
                            <TextBox Grid.Column="1" x:Name="CentralFileBox" VerticalContentAlignment="Center" />
                            <Button Grid.Column="2" Content="{x:Static loc:Strings.Browse}" Click="OnBrowseCentralFile" Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock Style="{StaticResource OptionHelp}" Margin="0,0,0,16" Text="{x:Static loc:Strings.CentralFileHelp}" />

                        <!-- Astreinte : consignes de l'équipe (texte ou fichier), diffusées par le fichier d'environnement. -->
                        <TextBlock Text="{x:Static loc:Strings.DutySection}" Style="{StaticResource SectionTitle}" />
                        <Label Content="{x:Static loc:Strings.DutyTextLabel}" Target="{Binding ElementName=DutyTextBox}" Padding="0,0,0,4" />
                        <TextBox x:Name="DutyTextBox" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" MinHeight="96" MaxHeight="220"
                                 VerticalScrollBarVisibility="Auto" MaxLength="8000" />
                        <TextBlock Style="{StaticResource OptionHelp}" Margin="0,4,0,8" Text="{x:Static loc:Strings.DutyTextHelp}" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label Content="{x:Static loc:Strings.DutyFileLabel}" Target="{Binding ElementName=DutyFileBox}" />
                            <TextBox Grid.Column="1" x:Name="DutyFileBox" VerticalContentAlignment="Center" MaxLength="1024" />
                            <Button Grid.Column="2" Content="{x:Static loc:Strings.Browse}" Click="OnBrowseDutyFile" Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock Style="{StaticResource OptionHelp}" Margin="0,0,0,8" Text="{x:Static loc:Strings.DutyFileHelp}" />
                        <!-- Rappels pendant l'intervention : une ligne par rappel, minutes depuis le début puis le texte. -->
                        <Label Content="{x:Static loc:Strings.RemindersLabel}" Target="{Binding ElementName=RemindersBox}" Padding="0,0,0,4" />
                        <TextBox x:Name="RemindersBox" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" MinHeight="58" MaxHeight="160"
                                 VerticalScrollBarVisibility="Auto" MaxLength="2400" FontFamily="Consolas, Courier New"
                                 AutomationProperties.HelpText="{x:Static loc:Strings.RemindersHelp}" />
                        <TextBlock Style="{StaticResource OptionHelp}" Margin="0,4,0,16" Text="{x:Static loc:Strings.RemindersHelp}" />

                        <!-- Étiquettes des serveurs de « Mes serveurs » (PROD, QA, DEV…) : nom et couleur. -->
                        <TextBlock Text="{x:Static loc:Strings.ServerTagsSection}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource OptionHelp}" Margin="0,0,0,6" Text="{x:Static loc:Strings.ServerTagsHelp}" />
                        <DataGrid x:Name="TagGrid" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False"
                                  CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserSortColumns="False" SelectionMode="Single"
                                  SelectionUnit="FullRow" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource GridLineBrush}"
                                  MinHeight="60" MaxHeight="220" SelectionChanged="OnTagSelected"
                                  AutomationProperties.Name="{x:Static loc:Strings.ServerTagsSection}">
                            <DataGrid.Columns>
                                <!-- Aperçu : la pastille telle qu'elle apparaîtra sur l'onglet. -->
                                <DataGridTemplateColumn Width="Auto" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Background}" CornerRadius="3" Padding="5,0,5,1" Margin="4,2"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="{Binding Foreground}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{x:Static loc:Strings.ServerTagColName}" Width="*"
                                                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Margin" Value="2,0" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="MaxLength" Value="{x:Static core:ServerTagRules.MaxNameLength}" />
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="{x:Static loc:Strings.ServerTagColColor}" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding Colors}" SelectedValuePath="Hex"
                                                      SelectedValue="{Binding Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      AutomationProperties.Name="{Binding ColorName}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Rectangle Width="14" Height="14" Fill="{Binding Brush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,8">
                            <Button x:Name="AddTagButton" Click="OnAddTag" ToolTipService.ShowOnDisabled="True">
                                <AccessText Text="{x:Static loc:Strings.ServerTagAdd}" />
                            </Button>
                            <Button x:Name="RemoveTagButton" Click="OnRemoveTag" IsEnabled="False" Margin="8,0,0,0">
                                <AccessText Text="{x:Static loc:Strings.ServerTagRemove}" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== CyberArk ===== -->
            <TabItem x:Name="CyberArkPage" Header="{x:Static loc:Strings.SettingsPageCyberArk}">
                <ScrollViewer>
                    <StackPanel Margin="16,12">
                        <TextBlock Text="{x:Static loc:Strings.PvwaSessionSection}" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="KeepAliveBox" Margin="0,0,0,2">
                            <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.KeepAlive}" />
                        </CheckBox>
                        <TextBlock Style="{StaticResource OptionEffect}" Text="{x:Static loc:Strings.SettingsKeepAliveEffect}" Margin="20,0,0,10" />
                        <CheckBox x:Name="KeepAccountListCopyBox" Margin="0,0,0,2">
                            <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.KeepAccountListCopy}" />
                        </CheckBox>
                        <TextBlock Style="{StaticResource OptionHelp}" Margin="22,0,0,16" Text="{x:Static loc:Strings.KeepAccountListCopyHelp}" />

                        <TextBlock Text="{x:Static loc:Strings.SettingsSshSection}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="{x:Static loc:Strings.SettingsSshHelp}" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <Label Content="{x:Static loc:Strings.PsmpAddressLabel}" Target="{Binding ElementName=PsmpBox}" />
                            <TextBox Grid.Column="1" x:Name="PsmpBox" VerticalContentAlignment="Center" TextChanged="OnPsmpChanged" />
                            <Label Grid.Column="2" Content="{x:Static loc:Strings.PortLabel}" Target="{Binding ElementName=PortBox}" Margin="8,0,0,0" />
                            <TextBox Grid.Column="3" x:Name="PortBox" VerticalContentAlignment="Center" TextChanged="OnPsmpChanged" />
                        </Grid>
                        <TextBlock Style="{StaticResource OptionHelp}" Margin="0,0,0,12" Text="{x:Static loc:Strings.PsmpDefaultHelp}" />

                        <!-- Autres PSMP : chaque serveur passe par celui de son domaine le plus proche (voir PsmpRouting). -->
                        <TextBlock Text="{x:Static loc:Strings.PsmpListSection}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource OptionHelp}" Margin="0,0,0,6" Text="{x:Static loc:Strings.PsmpListHelp}" />
                        <DataGrid x:Name="PsmpGrid" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False"
                                  CanUserDeleteRows="False" CanUserReorderColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource GridLineBrush}"
                                  MinHeight="80" MaxHeight="180" SelectionChanged="OnPsmpSelected"
                                  AutomationProperties.Name="{x:Static loc:Strings.PsmpListSection}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{x:Static loc:Strings.PsmpColumnAddress}" Width="2*"
                                                    Binding="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="{x:Static loc:Strings.PsmpColumnPort}" Width="60"
                                                    Binding="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="{x:Static loc:Strings.PsmpColumnDomain}" Width="2*"
                                                    Binding="{Binding Domain, UpdateSourceTrigger=PropertyChanged}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,10">
                            <Button Content="{x:Static loc:Strings.PsmpAdd}" Click="OnAddPsmp" />
                            <Button x:Name="RemovePsmpButton" Content="{x:Static loc:Strings.PsmpRemove}" Click="OnRemovePsmp"
                                    IsEnabled="False" Margin="8,0,0,0" />
                        </StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Content="{x:Static loc:Strings.PsmpTestLabel}" Target="{Binding ElementName=PsmpTestBox}" />
                            <TextBox Grid.Column="1" x:Name="PsmpTestBox" VerticalContentAlignment="Center" TextChanged="OnPsmpChanged" />
                        </Grid>
                        <views:AnnouncedText x:Name="PsmpTestText" Style="{StaticResource OptionHelp}" Margin="0,0,0,8"
                                             AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Style="{StaticResource OptionEffect}" Margin="0,0,0,16" Text="{x:Static loc:Strings.PsmpSecurityEffect}" />

                        <TextBlock Text="{x:Static loc:Strings.ComponentsSection}" Style="{StaticResource SectionTitle}" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Content="{x:Static loc:Strings.WindowsComponentLabel}" Target="{Binding ElementName=WindowsComponentBox}" />
                            <ComboBox Grid.Column="1" x:Name="WindowsComponentBox" IsEditable="True" MaxWidth="320" HorizontalAlignment="Left"
                                      MinWidth="220" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Style="{StaticResource OptionHelp}" Margin="0,0,0,10" Text="{x:Static loc:Strings.WindowsComponentHelp}" />
                        <CheckBox x:Name="PsmDesktopInTabBox" Margin="0,0,0,2">
                            <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.PsmDesktopInTab}" />
                        </CheckBox>
                        <TextBlock Style="{StaticResource OptionHelp}" Margin="22,0,0,10" Text="{x:Static loc:Strings.PsmDesktopInTabHelp}" />
                        <CheckBox x:Name="PsmDynamicResolutionBox" Margin="22,0,0,2"
                                  IsEnabled="{Binding IsChecked, ElementName=PsmDesktopInTabBox}">
                            <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.PsmDynamicResolution}" />
                        </CheckBox>
                        <TextBlock Style="{StaticResource OptionHelp}" Margin="44,0,0,10" Text="{x:Static loc:Strings.PsmDynamicResolutionHelp}" />
                        <!-- Onglet et Connexion Bureau à distance : jamais grisée. -->
                        <CheckBox x:Name="PsmRedirectDrivesBox" Margin="0,0,0,2">
                            <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.PsmRedirectDrives}" />
                        </CheckBox>
                        <TextBlock Style="{StaticResource OptionHelp}" Margin="22,0,0,10" Text="{x:Static loc:Strings.PsmRedirectDrivesHelp}" />
                        <!-- Toute session Bureau à distance dans un onglet (PSM, KeePass) avec le client FreeRDP : jamais grisée. -->
                        <CheckBox x:Name="PauseRdpDisplayBox" Margin="0,0,0,2">
                            <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.PauseRdpDisplay}" />
                        </CheckBox>
                        <TextBlock Style="{StaticResource OptionHelp}" Margin="22,0,0,10" Text="{x:Static loc:Strings.PauseRdpDisplayHelp}" />
                        <!-- Composant par plateforme : prioritaire sur celui des comptes Windows (voir AppSettings.ResolveComponent). -->
                        <TextBlock Text="{x:Static loc:Strings.PlatformComponentsSection}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource OptionHelp}" Margin="0,0,0,6" Text="{x:Static loc:Strings.PlatformComponentsHelp}" />
                        <DataGrid x:Name="ComponentGrid" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False"
                                  CanUserDeleteRows="False" CanUserReorderColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource GridLineBrush}"
                                  MinHeight="60" MaxHeight="180" SelectionChanged="OnComponentSelected"
                                  AutomationProperties.Name="{x:Static loc:Strings.PlatformComponentsSection}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{x:Static loc:Strings.ComponentColumnPlatform}" Width="*"
                                                    Binding="{Binding Platform, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="{x:Static loc:Strings.ComponentColumnComponent}" Width="*"
                                                    Binding="{Binding Component, UpdateSourceTrigger=PropertyChanged}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,8">
                            <Button Content="{x:Static loc:Strings.ComponentAdd}" Click="OnAddComponent" />
                            <Button x:Name="RemoveComponentButton" Content="{x:Static loc:Strings.ComponentRemove}" Click="OnRemoveComponent"
                                    IsEnabled="False" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Terminal ===== -->
            <TabItem x:Name="TerminalPage" Header="{x:Static loc:Strings.SettingsPageTerminal}">
                <ScrollViewer>
                    <StackPanel Margin="16,12">
                        <CheckBox x:Name="SshInAppBox" Margin="0,0,0,12">
                            <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.SshInApp}" />
                        </CheckBox>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <Label Content="{x:Static loc:Strings.TerminalThemeLabel}" Target="{Binding ElementName=ThemeBox}" />
                            <ComboBox Grid.Column="1" x:Name="ThemeBox" VerticalAlignment="Center" />
                            <Label Grid.Column="2" Content="{x:Static loc:Strings.TerminalFontLabel}" Target="{Binding ElementName=FontSizeBox}" Margin="8,0,0,0" />
                            <TextBox Grid.Column="3" x:Name="FontSizeBox" VerticalContentAlignment="Center" ToolTip="{x:Static loc:Strings.TerminalFontTip}" />
                        </Grid>
                        <CheckBox x:Name="ConfirmPasteBox" Margin="0,0,0,8">
                            <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.SettingsConfirmPaste}" />
                        </CheckBox>
                        <CheckBox x:Name="ConfirmCloseBox" Margin="0,0,0,8">
                            <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.SettingsConfirmClose}" />
                        </CheckBox>
                        <CheckBox x:Name="RightClickBox" Margin="0,0,0,2">
                            <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.SettingsRightClickPastes}" />
                        </CheckBox>
                        <TextBlock Style="{StaticResource OptionEffect}" Text="{x:Static loc:Strings.SettingsRightClickEffect}" />
                        <CheckBox x:Name="FollowBox" Margin="0,0,0,2">
                            <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.FollowSetting}" />
                        </CheckBox>
                        <TextBlock Style="{StaticResource OptionEffect}" Text="{x:Static loc:Strings.SettingsFollowEffect}" />

                        <TextBlock Text="{x:Static loc:Strings.X11Section}" Style="{StaticResource SectionTitle}" />
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="140" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <Label Content="{x:Static loc:Strings.X11DisplayLabel}" Target="{Binding ElementName=X11DisplayBox}" />
                            <TextBox Grid.Column="1" x:Name="X11DisplayBox" VerticalContentAlignment="Center" />
                        </Grid>
                        <TextBlock Style="{StaticResource OptionHelp}" Text="{x:Static loc:Strings.X11DisplayHelp}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Fichiers ===== -->
            <TabItem x:Name="FilesPage" Header="{x:Static loc:Strings.SettingsPageFiles}">
                <ScrollViewer>
                    <StackPanel Margin="16,12">
                        <WrapPanel Margin="0,0,0,10" ToolTip="{x:Static loc:Strings.UploadProtocolTip}">
                            <Label x:Name="UploadLabel" Content="{x:Static loc:Strings.UploadLabel}" Target="{Binding ElementName=SftpRadio}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" Padding="0" />
                            <RadioButton x:Name="SftpRadio" Content="SFTP" GroupName="Upload" Margin="0,0,16,0" VerticalAlignment="Center"
                                         AutomationProperties.LabeledBy="{Binding ElementName=UploadLabel}" />
                            <RadioButton x:Name="ScpRadio" Content="SCP" GroupName="Upload" VerticalAlignment="Center"
                                         AutomationProperties.LabeledBy="{Binding ElementName=UploadLabel}" />
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,10" ToolTip="{x:Static loc:Strings.SettingsArchiveTip}">
                            <CheckBox x:Name="ArchiveBox" VerticalAlignment="Center">
                                <AccessText Text="{x:Static loc:Strings.SettingsArchiveOffer}" />
                            </CheckBox>
                            <TextBox x:Name="ArchiveThresholdBox" Width="60" Margin="6,0,6,0" VerticalAlignment="Center"
                                     IsEnabled="{Binding IsChecked, ElementName=ArchiveBox}" AutomationProperties.Name="{x:Static loc:Strings.A11yArchiveThreshold}" />
                            <TextBlock Text="{x:Static loc:Strings.SettingsArchiveFiles}" VerticalAlignment="Center" />
                        </WrapPanel>
                        <CheckBox x:Name="TailSessionBox" Margin="0,0,0,2">
                            <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.SettingsTailSession}" />
                        </CheckBox>
                        <TextBlock Style="{StaticResource OptionHelp}" Text="{x:Static loc:Strings.SettingsTailSessionHelp}" Margin="20,0,0,16" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Content="{x:Static loc:Strings.TextEditorLabel}" Target="{Binding ElementName=EditorBox}" />
                            <TextBox Grid.Column="1" x:Name="EditorBox" VerticalContentAlignment="Center" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Placeholder}" Tag="{Binding ElementName=EditorBox}"
                                       Text="notepad.exe" Margin="6,0,0,0" />
                            <Button Grid.Column="2" Content="{x:Static loc:Strings.Browse}" Click="OnBrowseEditor" Margin="8,0,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{x:Static loc:Strings.TextEditorHelp}"
                                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </Grid>
                        <!-- Outil de comparaison externe (facultatif) : la comparaison intégrée suffit sinon. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Content="{x:Static loc:Strings.CompareToolLabel}" Target="{Binding ElementName=CompareToolBox}" />
                            <TextBox Grid.Column="1" x:Name="CompareToolBox" VerticalContentAlignment="Center" />
                            <Button Grid.Column="2" Content="{x:Static loc:Strings.BrowseOther}" Click="OnBrowseCompareTool" Margin="8,0,0,0" />
                            <Label Grid.Row="1" Content="{x:Static loc:Strings.CompareArgumentsLabel}" Target="{Binding ElementName=CompareArgsBox}" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="CompareArgsBox" VerticalContentAlignment="Center" Margin="0,4,0,0"
                                     FontFamily="Consolas, Courier New" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{x:Static loc:Strings.CompareToolHelp}"
                                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Partage de sessions ===== -->
            <TabItem x:Name="SharingPage" Header="{x:Static loc:Strings.SettingsPageSharing}">
                <ScrollViewer>
                    <StackPanel Margin="16,12">
                        <CheckBox x:Name="SessionSharingBox" Margin="0,0,0,2">
                            <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.SettingsSessionSharing}" />
                        </CheckBox>
                        <TextBlock Style="{StaticResource OptionHelp}" Text="{x:Static loc:Strings.SettingsSessionSharingHelp}" Margin="20,0,0,14" />
                        <!-- Par où les autres rejoignent mes partages : directement, sinon par le dossier relais. -->
                        <StackPanel IsEnabled="{Binding IsChecked, ElementName=SessionSharingBox}">
                            <WrapPanel Margin="0,0,0,2">
                                <CheckBox x:Name="ShareDirectBox" VerticalAlignment="Center">
                                    <AccessText Text="{x:Static loc:Strings.SettingsShareDirect}" />
                                </CheckBox>
                                <Label Content="{x:Static loc:Strings.SettingsSharePort}" Target="{Binding ElementName=SharePortBox}" Margin="16,0,4,0" Padding="0"
                                       VerticalAlignment="Center" />
                                <TextBox x:Name="SharePortBox" Width="70" VerticalAlignment="Center" MaxLength="5"
                                         IsEnabled="{Binding IsChecked, ElementName=ShareDirectBox}" ToolTip="{x:Static loc:Strings.SettingsSharePortTip}" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource OptionHelp}" Text="{x:Static loc:Strings.SettingsShareDirectHelp}" Margin="20,0,0,14" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Label Content="{x:Static loc:Strings.SettingsShareRelay}" Target="{Binding ElementName=ShareRelayBox}" />
                                <TextBox Grid.Column="1" x:Name="ShareRelayBox" VerticalContentAlignment="Center" MaxLength="400" />
                                <Button Grid.Column="2" Content="{x:Static loc:Strings.Browse}" Click="OnBrowseShareRelay" Margin="8,0,0,0" />
                            </Grid>
                            <TextBlock Style="{StaticResource OptionHelp}" Text="{x:Static loc:Strings.SettingsShareRelayHelp}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Sécurité ===== -->
            <TabItem x:Name="SecurityPage" Header="{x:Static loc:Strings.SettingsPageSecurity}">
                <DockPanel Margin="16,12">
                    <!-- Coffre local : actions immédiates, sans « Enregistrer ». -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                        <TextBlock Text="{x:Static loc:Strings.LocalStoreSection}" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="StoreText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <WrapPanel>
                            <Button x:Name="StoreCreateButton" Content="{x:Static loc:Strings.LocalStoreCreate}" Click="OnStoreCreate" Margin="0,0,8,4" />
                            <Button x:Name="StoreUnlockButton" Content="{x:Static loc:Strings.LocalStoreUnlockMenu}" Click="OnStoreUnlock" Margin="0,0,8,4" />
                            <Button x:Name="StoreChangeButton" Content="{x:Static loc:Strings.LocalStoreChange}" Click="OnStoreChange" Margin="0,0,8,4" />
                            <Button x:Name="StoreDeleteButton" Content="{x:Static loc:Strings.LocalStoreDelete}" Click="OnStoreDelete" Margin="0,0,8,4"
                                    Style="{StaticResource DangerButton}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource OptionHelp}" Margin="0,2,0,0" Text="{x:Static loc:Strings.LocalStoreImmediate}" />
                    </StackPanel>

                    <!-- Clés de serveur acceptées : oubliées à l'enregistrement (la connexion suivante redemandera l'empreinte). -->
                    <TextBlock DockPanel.Dock="Top" Text="{x:Static loc:Strings.HostKeysSection}" Style="{StaticResource SectionTitle}" />
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <Button x:Name="ForgetKeysButton" DockPanel.Dock="Right" Content="{x:Static loc:Strings.ForgetSelectedKeys}"
                                Click="OnForgetHostKeys" IsEnabled="False" VerticalAlignment="Top" />
                        <TextBlock x:Name="HostKeysText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,12,0"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <DataGrid x:Name="HostKeysGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource GridLineBrush}"
                              SelectionMode="Extended" SelectionUnit="FullRow" CanUserAddRows="False" MinHeight="90"
                              SelectionChanged="OnHostKeySelected" AutomationProperties.Name="{x:Static loc:Strings.HostKeysSection}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{x:Static loc:Strings.HostKeyServer}" Binding="{Binding Server}" Width="2*" />
                            <DataGridTextColumn Header="{x:Static loc:Strings.HostKeyType}" Binding="{Binding Algorithm}" Width="*" />
                            <DataGridTextColumn Header="{x:Static loc:Strings.HostKeyFingerprint}" Binding="{Binding Fingerprint}" Width="3*"
                                                FontFamily="Consolas, Courier New" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
