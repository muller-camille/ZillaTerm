<Window x:Class="ZillaTerm.App.Views.SessionPropertiesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ZillaTerm.App.Views"
        xmlns:loc="clr-namespace:ZillaTerm.App.Localization"
        Title="{x:Static loc:Strings.PropertiesTitle}" Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource ToolbarBrush}" BorderBrush="{DynamicResource ToolbarBorderBrush}"
                BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel>
                <Image x:Name="KindIcon" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="AccountText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DetailsText" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel DockPanel.Dock="Bottom" Margin="16,4,16,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="{x:Static loc:Strings.Save}" IsDefault="True" Click="OnSave" />
                <Button Content="{x:Static loc:Strings.Cancel}" IsCancel="True" Margin="8,0,0,0" />
            </StackPanel>
            <views:ErrorLine x:Name="ErrorText" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,12,0" />
        </DockPanel>

        <Grid Margin="16,12,16,8">
            <!-- Étiquettes à la largeur du plus long texte (italien). -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.ColumnSpan="2" Text="{x:Static loc:Strings.DisplaySection}" Style="{StaticResource SectionTitle}" />
            <Label Grid.Row="1" Content="{x:Static loc:Strings.NameLabel}" Target="{Binding ElementName=NameBox}" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="NameBox" Margin="0,0,0,8" />
            <Label Grid.Row="2" Content="{x:Static loc:Strings.FolderLabel}" Target="{Binding ElementName=FolderBox}" />
            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="FolderBox" IsEditable="True" Margin="0,0,0,8"
                      ToolTip="{x:Static loc:Strings.FolderTip}" />
            <!-- Étiquette d'environnement (PROD, QA…) : sa couleur marque l'onglet et la session. -->
            <Label Grid.Row="3" Content="{x:Static loc:Strings.TagLabel}" Target="{Binding ElementName=TagBox}" />
            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="TagBox" Margin="0,0,0,12" HorizontalAlignment="Left" MinWidth="160"
                      ToolTip="{x:Static loc:Strings.TagTip}" />

            <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{x:Static loc:Strings.ConnectionSection}" Style="{StaticResource SectionTitle}" />
            <Label Grid.Row="5" x:Name="ModeLabel" Content="{x:Static loc:Strings.ConnectionTypeLabel}" Target="{Binding ElementName=PsmRadio}" />
            <WrapPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,8">
                <RadioButton x:Name="PsmRadio" Content="{x:Static loc:Strings.ModePsm}" GroupName="Mode" Margin="0,0,24,4" Checked="OnModeChanged"
                             AutomationProperties.LabeledBy="{Binding ElementName=ModeLabel}" />
                <RadioButton x:Name="SshRadio" Content="{x:Static loc:Strings.ModeSsh}" GroupName="Mode" Margin="0,0,24,4" Checked="OnModeChanged"
                             AutomationProperties.LabeledBy="{Binding ElementName=ModeLabel}" />
                <RadioButton x:Name="SftpRadio" Content="{x:Static loc:Strings.ModeSftp}" GroupName="Mode" Margin="0,0,0,4" Checked="OnModeChanged"
                             AutomationProperties.LabeledBy="{Binding ElementName=ModeLabel}" />
            </WrapPanel>
            <Label Grid.Row="6" Content="{x:Static loc:Strings.ComponentLabel}" Target="{Binding ElementName=ComponentBox}" />
            <ComboBox Grid.Row="6" Grid.Column="1" x:Name="ComponentBox" IsEditable="True" Margin="0,0,0,8"
                      ToolTip="{x:Static loc:Strings.ComponentEmptyTip}" />
            <Label Grid.Row="7" Content="{x:Static loc:Strings.TargetMachineLabel}" Target="{Binding ElementName=MachineBox}" />
            <ComboBox Grid.Row="7" Grid.Column="1" x:Name="MachineBox" IsEditable="True" Margin="0,0,0,8" />
            <Label Grid.Row="8" Content="{x:Static loc:Strings.DefaultReasonLabel}" Target="{Binding ElementName=ReasonBox}" />
            <TextBox Grid.Row="8" Grid.Column="1" x:Name="ReasonBox" Margin="0,0,0,8" />
            <Label Grid.Row="9" Content="{x:Static loc:Strings.StartDirLabel}" Target="{Binding ElementName=StartDirBox}" />
            <TextBox Grid.Row="9" Grid.Column="1" x:Name="StartDirBox" Margin="0,0,0,8"
                     ToolTip="{x:Static loc:Strings.StartDirTip}" />
            <CheckBox Grid.Row="10" Grid.Column="1" x:Name="X11Box" Margin="0,0,0,8" ToolTip="{x:Static loc:Strings.X11ForwardingTip}">
                <AccessText Text="{x:Static loc:Strings.X11Forwarding}" TextWrapping="Wrap" />
            </CheckBox>
            <TextBlock Grid.Row="11" Grid.Column="1" x:Name="X11Effect" Style="{StaticResource CheckedOptionEffect}" Tag="{Binding ElementName=X11Box}"
                       Margin="20,-6,0,8" Text="{x:Static loc:Strings.X11ForwardingEffect}" />
        </Grid>
    </DockPanel>
</Window>
