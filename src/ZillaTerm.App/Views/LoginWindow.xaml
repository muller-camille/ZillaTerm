<Window x:Class="ZillaTerm.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ZillaTerm.App.Views"
        xmlns:loc="clr-namespace:ZillaTerm.App.Localization"
        Title="{x:Static loc:Strings.LoginTitle}"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{x:Static loc:Strings.LoginHeading}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{x:Static loc:Strings.LoginSubtitle}"
                       Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Saisie des identifiants -->
        <Grid Grid.Row="1" x:Name="CredentialsPanel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Content="{x:Static loc:Strings.LoginAddress}" Target="{Binding ElementName=UrlBox}" Margin="0,0,8,8" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="UrlBox" Margin="0,0,0,8"
                     ToolTip="{x:Static loc:Strings.LoginAddressTip}" />

            <Label Grid.Row="1" Content="{x:Static loc:Strings.LoginMethod}" Target="{Binding ElementName=MethodBox}" Margin="0,0,8,8" />
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="MethodBox" Margin="0,0,0,8"
                      SelectionChanged="OnMethodChanged" />

            <Label Grid.Row="2" Content="{x:Static loc:Strings.LoginUser}" Target="{Binding ElementName=UserBox}" Margin="0,0,8,8" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="UserBox" Margin="0,0,0,8" />

            <Label Grid.Row="3" Content="{x:Static loc:Strings.LoginPassword}" Target="{Binding ElementName=PasswordBox}" Margin="0,0,8,8" />
            <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="PasswordBox" Margin="0,0,0,8" />
        </Grid>

        <!-- Challenge RADIUS (MFA) : affiché seulement si le PVWA le demande -->
        <StackPanel Grid.Row="1" x:Name="ChallengePanel" Visibility="Collapsed">
            <TextBlock x:Name="ChallengeText" TextWrapping="Wrap" Margin="0,0,0,8" />
            <!-- Nom accessible du champ : la question du PVWA. -->
            <PasswordBox x:Name="ChallengeBox" Margin="0,0,0,8"
                         AutomationProperties.LabeledBy="{Binding ElementName=ChallengeText}" />
        </StackPanel>

        <StackPanel Grid.Row="2">
            <!-- Avertissement Verr. Maj, pendant la saisie du mot de passe. -->
            <views:AnnouncedText x:Name="CapsLockText" Text="{x:Static loc:Strings.CapsLockOn}" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,6"
                                 Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
            <views:ErrorLine x:Name="StatusText" Margin="0,4,0,8" Visibility="Collapsed" />
        </StackPanel>

        <DockPanel Grid.Row="3" LastChildFill="False" Margin="0,8,0,0">
            <ComboBox x:Name="LanguageBox" DockPanel.Dock="Left" Padding="6,2" VerticalAlignment="Center"
                      ToolTip="{x:Static loc:Strings.LoginLanguageTip}" SelectionChanged="OnLanguageChanged"
                      AutomationProperties.Name="{x:Static loc:Strings.LoginLanguageName}" />
            <ProgressBar x:Name="Busy" DockPanel.Dock="Left" Width="70" Height="6" Margin="10,0,0,0"
                         IsIndeterminate="True" Visibility="Hidden" VerticalAlignment="Center" />
            <!-- Sans connexion, l'application se ferme : le bouton le dit. -->
            <Button DockPanel.Dock="Right" Content="{x:Static loc:Strings.LoginQuit}" IsCancel="True" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" x:Name="LoginButton" Content="{x:Static loc:Strings.LoginButton}" IsDefault="True"
                    Click="OnLoginClick" />
        </DockPanel>

        <!-- Accès d'urgence : coffres KeePass, sans passer par CyberArk. -->
        <Border Grid.Row="4" BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,10,0,0">
            <DockPanel>
                <!-- Environnement de l'équipe (PVWA, PSMP, composants) depuis un fichier qu'elle a fourni. -->
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Focusable="True"
                        ToolTip="{x:Static loc:Strings.LoginEnvImportTip}" Click="OnImportEnvironment">
                    <AccessText Text="{x:Static loc:Strings.LoginEnvImport}" VerticalAlignment="Center" />
                </Button>
                <Button x:Name="EmergencyButton" Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Focusable="True"
                        ToolTip="{x:Static loc:Strings.LoginEmergencyTip}" Click="OnEmergencyClick">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{DynamicResource IconKeePass}" Width="18" Height="18" Margin="0,0,8,0" />
                        <AccessText Text="{x:Static loc:Strings.LoginEmergency}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</Window>
