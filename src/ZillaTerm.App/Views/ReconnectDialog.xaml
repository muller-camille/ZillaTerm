<Window x:Class="ZillaTerm.App.Views.ReconnectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ZillaTerm.App.Views"
        xmlns:loc="clr-namespace:ZillaTerm.App.Localization"
        Title="{x:Static loc:Strings.ReconnectTitle}" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource ToolbarBrush}" BorderBrush="{DynamicResource ToolbarBorderBrush}"
                BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel>
                <Image Source="{DynamicResource IconKey}" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Static loc:Strings.ReconnectTitle}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="WhoText" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,4,16,16">
            <Button x:Name="ReconnectButton" Content="{x:Static loc:Strings.ReconnectButton}" IsDefault="True" Click="OnReconnect" />
            <Button Content="{x:Static loc:Strings.ReconnectLater}" IsCancel="True" Margin="8,0,0,0"
                    ToolTip="{x:Static loc:Strings.ReconnectLaterTip}" />
        </StackPanel>

        <StackPanel Margin="16,12,16,8">
            <TextBlock Text="{x:Static loc:Strings.ReconnectIntro}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <Grid x:Name="CredentialsPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Content="{x:Static loc:Strings.LoginPassword}" Target="{Binding ElementName=PasswordBox}" />
                <PasswordBox Grid.Column="1" x:Name="PasswordBox" Margin="0,0,0,8" VerticalContentAlignment="Center" />
            </Grid>
            <!-- Challenge RADIUS : la question du PVWA, puis la réponse. -->
            <StackPanel x:Name="ChallengePanel" Visibility="Collapsed">
                <TextBlock x:Name="ChallengeText" TextWrapping="Wrap" Margin="0,0,0,8" />
                <PasswordBox x:Name="ChallengeBox" Margin="0,0,0,8" AutomationProperties.LabeledBy="{Binding ElementName=ChallengeText}" />
            </StackPanel>
            <ProgressBar x:Name="Busy" Height="6" IsIndeterminate="True" Margin="0,4,0,4" Visibility="Hidden" />
            <views:ErrorLine x:Name="ErrorMessage" Visibility="Collapsed" />
            <views:AnnouncedText x:Name="CapsLockText" Text="{x:Static loc:Strings.CapsLockOn}" Foreground="{DynamicResource WarningBrush}"
                                 Margin="0,4,0,0" Visibility="Collapsed" />
        </StackPanel>
    </DockPanel>
</Window>
