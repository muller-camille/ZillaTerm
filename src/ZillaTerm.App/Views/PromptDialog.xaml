<Window x:Class="ZillaTerm.App.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ZillaTerm.App.Views"
        xmlns:loc="clr-namespace:ZillaTerm.App.Localization"
        Title="{x:Static loc:Strings.PromptTitle}" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <DockPanel Margin="0,0,0,12">
            <Image Source="{DynamicResource IconSsh}" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Top" />
            <StackPanel>
                <!-- Session qui pose la question : plusieurs peuvent s'ouvrir ensemble (vue parallèle, multi-sélection). -->
                <TextBlock x:Name="SessionText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4"
                           Visibility="Collapsed" />
                <TextBlock x:Name="InstructionText" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>
        <!-- Réponse précédente refusée : dit avant la saisie, avec le numéro de l'essai (verrouillage du compte). -->
        <views:AnnouncedText x:Name="RefusedText" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" Margin="0,0,0,8" Visibility="Collapsed"
                             AutomationProperties.LiveSetting="Assertive" />
        <!-- Champ nommé par la question du serveur (« Password: »…) pour les lecteurs d'écran. -->
        <PasswordBox x:Name="SecretBox" Margin="0,0,0,6" AutomationProperties.LabeledBy="{Binding ElementName=PromptText}" />
        <views:AnnouncedText x:Name="CapsLockText" Text="{x:Static loc:Strings.CapsLockOn}" Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,6"
                             Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
        <TextBox x:Name="TextBox" Margin="0,0,0,6" Visibility="Collapsed" AutomationProperties.LabeledBy="{Binding ElementName=PromptText}" />
        <TextBlock x:Name="HintText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6" Visibility="Collapsed" />
        <!-- Groupe de sessions ouvertes ensemble : un seul mot de passe pour toutes, en mémoire seulement. -->
        <CheckBox x:Name="ShareBox" Margin="0,2,0,6" Visibility="Collapsed">
            <TextBlock Text="{x:Static loc:Strings.PromptShareWithGroup}" TextWrapping="Wrap" />
        </CheckBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="{x:Static loc:Strings.PromptSend}" IsDefault="True" Click="OnOk" />
            <Button Content="{x:Static loc:Strings.Cancel}" IsCancel="True" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
