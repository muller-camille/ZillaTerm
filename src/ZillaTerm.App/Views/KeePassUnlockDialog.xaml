<Window x:Class="ZillaTerm.App.Views.KeePassUnlockDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ZillaTerm.App.Views"
        xmlns:loc="clr-namespace:ZillaTerm.App.Localization"
        Title="{x:Static loc:Strings.KeePassUnlockTitle}" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource ToolbarBrush}" BorderBrush="{DynamicResource ToolbarBorderBrush}"
                BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel>
                <Image Source="{DynamicResource IconKeePass}" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="NameText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="PathText" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,4,16,16">
            <Button x:Name="UnlockButton" Content="{x:Static loc:Strings.KeePassUnlock}" IsDefault="True" Click="OnUnlock" />
            <Button Content="{x:Static loc:Strings.Cancel}" IsCancel="True" Margin="8,0,0,0" Click="OnCancel" />
        </StackPanel>

        <Grid x:Name="Form" Margin="16,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label x:Name="PasswordLabel" Content="{x:Static loc:Strings.KeePassMasterPasswordLabel}" Target="{Binding ElementName=PasswordBox}" />
            <PasswordBox Grid.Column="1" Grid.ColumnSpan="2" x:Name="PasswordBox" Margin="0,0,0,8" VerticalContentAlignment="Center" />
            <Label Grid.Row="1" Content="{x:Static loc:Strings.KeePassKeyFileLabel}" Target="{Binding ElementName=KeyFileBox}" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="KeyFileBox" Margin="0,0,0,8" VerticalContentAlignment="Center" />
            <Button Grid.Row="1" Grid.Column="2" Content="{x:Static loc:Strings.Browse}" Click="OnBrowseKeyFile" Margin="8,0,0,8" />
            <CheckBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="RememberBox" Margin="0,2,0,0">
                <AccessText Text="{x:Static loc:Strings.KeePassRemember}" TextWrapping="Wrap" />
            </CheckBox>
            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="RememberHint" Text="{x:Static loc:Strings.KeePassRememberHint}"
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="20,2,0,8" />
            <ProgressBar Grid.Row="4" Grid.ColumnSpan="3" x:Name="Progress" Height="6" IsIndeterminate="True" Margin="0,4,0,4" Visibility="Collapsed" />
            <views:AnnouncedText Grid.Row="5" Grid.ColumnSpan="3" x:Name="MessageText" TextWrapping="Wrap" Visibility="Collapsed"
                                 AutomationProperties.LiveSetting="Assertive" />
            <views:AnnouncedText Grid.Row="6" Grid.ColumnSpan="3" x:Name="CapsLockText" Text="{x:Static loc:Strings.CapsLockOn}" Foreground="{DynamicResource WarningBrush}"
                                 Margin="0,4,0,0" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</Window>
