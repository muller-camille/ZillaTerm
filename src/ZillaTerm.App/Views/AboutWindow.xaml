<Window x:Class="ZillaTerm.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ZillaTerm.App.Localization"
        Title="{x:Static loc:Strings.AboutTitle}" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="18">
        <DockPanel Margin="0,0,0,12">
            <!-- Source choisie selon l'échelle de l'écran (AboutWindow.ShowLogo) ; réduction lissée. -->
            <Image x:Name="LogoImage" DockPanel.Dock="Left" Width="56" Height="56" Margin="0,0,14,0" VerticalAlignment="Top"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel>
                <TextBlock Text="ZillaTerm" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,6" />
                <TextBlock Text="{x:Static loc:Strings.AboutDescription}" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <TextBlock Margin="0,0,0,4">
            <Hyperlink Click="OnProject"><Run Text="{x:Static loc:Strings.AboutProject}" /></Hyperlink>
            <Run Text="   " />
            <Hyperlink Click="OnReleases"><Run Text="{x:Static loc:Strings.AboutReleases}" /></Hyperlink>
        </TextBlock>
        <TextBlock x:Name="LicenseText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />

        <Border BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="0,1,0,1" Padding="0,8" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="SystemText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                <DockPanel Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right" Content="{x:Static loc:Strings.AboutOpenFolder}" Click="OnOpenSettingsFolder" Margin="8,0,0,0" />
                    <TextBlock x:Name="FolderText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Nouvelle version : recherche à la demande, téléchargement vérifié, jamais installé automatiquement. -->
        <TextBlock Text="{x:Static loc:Strings.AboutUpdates}" Style="{StaticResource SectionTitle}" />
        <DockPanel Margin="0,0,0,6">
            <Button x:Name="CheckButton" DockPanel.Dock="Left" Content="{x:Static loc:Strings.AboutCheck}" Click="OnCheck" Margin="0,0,10,0" />
            <TextBlock x:Name="UpdateText" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
        <StackPanel x:Name="UpdatePanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,6">
            <Button x:Name="DownloadButton" Content="{x:Static loc:Strings.AboutDownload}" Click="OnDownload" ToolTip="{x:Static loc:Strings.AboutDownloadTip}" />
            <Button Content="{x:Static loc:Strings.AboutReleasePage}" Click="OnReleasePage" Margin="8,0,0,0" />
            <Button x:Name="ShowFileButton" Content="{x:Static loc:Strings.AboutShowFile}" Click="OnShowFile" Margin="8,0,0,0" Visibility="Collapsed" />
        </StackPanel>
        <ProgressBar x:Name="DownloadProgress" Height="8" Maximum="1" Visibility="Collapsed" Margin="0,0,0,6" />
        <!-- Réglage de la recherche automatique : dans les Paramètres seulement (page Général). -->
        <TextBlock x:Name="AutoCheckText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,4" />
        <TextBlock Text="{x:Static loc:Strings.AboutUpdateNote}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

        <Button Content="{x:Static loc:Strings.CloseButton}" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" />
    </StackPanel>
</Window>
