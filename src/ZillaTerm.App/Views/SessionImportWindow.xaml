<Window x:Class="ZillaTerm.App.Views.SessionImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ZillaTerm.App.Views"
        xmlns:loc="clr-namespace:ZillaTerm.App.Localization"
        xmlns:coreloc="clr-namespace:ZillaTerm.Core.Localization;assembly=ZillaTerm.Core"
        Title="{x:Static loc:Strings.SessionImportTitle}" Width="1120" Height="700" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleIf" />
        <!-- Résultat : vert si importé, orange si à vérifier, rouge si non importé (pas de compte, non pris en charge), gris sinon. -->
        <Style x:Key="ResultText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Result}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Imported">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Check">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="NoAccount">
                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Unsupported">
                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="AlreadyPresent">
                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Excluded">
                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                </DataTrigger>
                <!-- Ligne sélectionnée : couleur du texte de la sélection, la seule lisible sur son fond (le texte dit le résultat). -->
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridCell}}" Value="True">
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="ImportButton" Content="{x:Static loc:Strings.SessionImportButton}" IsDefault="True" IsEnabled="False" Click="OnImport" />
                    <Button x:Name="ExportButton" Content="{x:Static loc:Strings.SessionImportExport}" IsEnabled="False" Margin="8,0,0,0" Click="OnExport" />
                    <Button x:Name="MissingAccountsButton" Content="{x:Static loc:Strings.SessionImportMissingAccounts}" IsEnabled="False" Margin="8,0,0,0"
                            Click="OnMissingAccounts" ToolTip="{x:Static loc:Strings.SessionImportMissingAccountsTip}" ToolTipService.ShowOnDisabled="True" />
                    <Button Content="{x:Static loc:Strings.CloseButton}" IsCancel="True" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <views:ErrorLine x:Name="ErrorMessage" Visibility="Collapsed" />
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel Margin="16,16,16,8">
            <TextBlock DockPanel.Dock="Top" Text="{x:Static loc:Strings.SessionImportIntro}" TextWrapping="Wrap" Margin="0,0,0,10" />

            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Content="{x:Static loc:Strings.SessionImportSource}" Target="{Binding ElementName=SourceBox}" />
                <ComboBox Grid.Column="1" x:Name="SourceBox" DisplayMemberPath="Label" Margin="0,0,8,0" SelectionChanged="OnSourceChanged" />
                <Button Grid.Column="2" x:Name="ReadButton" Content="{x:Static loc:Strings.SessionImportRead}" MinWidth="110" Click="OnRead" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SourceHint" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                           TextWrapping="Wrap" Margin="2,2,0,6" />
                <Label Grid.Row="2" Content="{x:Static loc:Strings.SessionImportFolder}" Target="{Binding ElementName=FolderBox}" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="FolderBox" VerticalContentAlignment="Center" Padding="3,2" Margin="0,0,8,0"
                         ToolTip="{x:Static loc:Strings.SessionImportFolderTip}" TextChanged="OnFolderChanged" />
            </Grid>

            <!-- Rappel de sécurité : aucun mot de passe lu, connexion toujours via CyberArk. -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource AccentLightBrush}" BorderBrush="{DynamicResource ToolHoverBorderBrush}"
                    BorderThickness="1" CornerRadius="3" Padding="10,6">
                <DockPanel>
                    <Image Source="{DynamicResource IconInfo}" Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,8,0" />
                    <TextBlock Text="{x:Static loc:Strings.SessionImportSecurity}" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <DockPanel DockPanel.Dock="Top" Margin="0,10,0,6">
                <CheckBox x:Name="ProblemsBox" DockPanel.Dock="Right" VerticalAlignment="Center" IsEnabled="False" Click="OnOnlyProblems">
                    <AccessText Text="{x:Static loc:Strings.SessionImportOnlyProblems}" />
                </CheckBox>
                <TextBlock x:Name="SummaryText" Text="{x:Static loc:Strings.SessionImportNothingRead}" FontWeight="SemiBold" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
            </DockPanel>

            <DataGrid x:Name="RowsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended"
                      SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource GridLineBrush}" AlternatingRowBackground="{DynamicResource AlternateRowBrush}"
                      ClipboardCopyMode="IncludeHeader" AutomationProperties.Name="{x:Static loc:Strings.SessionImportTitle}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn x:Name="IncludeColumn" Width="Auto" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Include, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanInclude}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{x:Static coreloc:CoreStrings.MigrationColFolder}" Binding="{Binding Folder}" IsReadOnly="True" Width="1.2*"
                                        ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{x:Static coreloc:CoreStrings.ColumnName}" Binding="{Binding Name}" IsReadOnly="True" Width="1.2*"
                                        ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{x:Static coreloc:CoreStrings.MigrationColProtocol}" Binding="{Binding Protocol}" IsReadOnly="True" Width="Auto" />
                    <DataGridTextColumn Header="{x:Static coreloc:CoreStrings.ColumnServer}" Binding="{Binding Server}" IsReadOnly="True" Width="1.3*"
                                        ElementStyle="{StaticResource CellText}" />
                    <DataGridTextColumn Header="{x:Static coreloc:CoreStrings.ColumnUser}" Binding="{Binding User}" IsReadOnly="True" Width="*"
                                        ElementStyle="{StaticResource CellText}" />
                    <DataGridTemplateColumn Header="{x:Static coreloc:CoreStrings.MigrationColAccount}" Width="1.8*" SortMemberPath="Account">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <!-- Plusieurs comptes possibles : le plus probable est choisi, un autre peut l'être. -->
                                    <ComboBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding Chosen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Visibility="{Binding CanChoose, Converter={StaticResource VisibleIf}}"
                                              ToolTip="{x:Static loc:Strings.SessionImportChooseTip}" AutomationProperties.Name="{Binding Name}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Display, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Details, Mode=OneWay}"
                                                         Foreground="{DynamicResource MutedBrush}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="{Binding Account}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Account}"
                                               Visibility="{Binding ShowsAccountText, Converter={StaticResource VisibleIf}}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{x:Static coreloc:CoreStrings.MigrationColConnection}" Binding="{Binding Connection}" IsReadOnly="True" Width="Auto" />
                    <!-- Étiquette devinée d'après le nom, le serveur, le safe et les dossiers ; une autre peut être choisie. -->
                    <DataGridTemplateColumn Header="{x:Static coreloc:CoreStrings.MigrationColTag}" Width="Auto" SortMemberPath="Tag">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding TagChoices}" SelectedValuePath="Value"
                                          SelectedValue="{Binding Tag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanTag}"
                                          MinWidth="90" ToolTip="{x:Static loc:Strings.SessionImportTagTip}"
                                          AutomationProperties.Name="{Binding TagName}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Background}" CornerRadius="3" Padding="5,0,5,1" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}" FontSize="11" />
                                            </Border>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{x:Static coreloc:CoreStrings.MigrationColResult}" Binding="{Binding Result}" IsReadOnly="True" Width="2*"
                                        ElementStyle="{StaticResource ResultText}" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DockPanel>
</Window>
