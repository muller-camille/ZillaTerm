    <!-- ===== Styles ===== -->

    <!-- Gros bouton icône + libellé de la barre d'outils. -->
    <Style x:Key="ToolButton" TargetType="Button">
        <Setter Property="MinWidth" Value="66" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="Margin" Value="1,0" />
        <!-- Atteignable au clavier (Tab entre dans la barre, les flèches passent d'un bouton à l'autre). -->
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <!-- Un bouton grisé dit pourquoi dans son infobulle ; les lecteurs d'écran la lisent comme aide. -->
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="AutomationProperties.HelpText" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ToolHoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ToolHoverBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ToolPressedBrush}" />
                        </Trigger>
                        <!-- Focus clavier bien visible : bordure d'accent. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ToolFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- « ✕ » d'un champ de recherche ou de filtre (ClearFieldButton), par-dessus le champ, à droite. -->
    <Style x:Key="ClearFieldButton" TargetType="Button">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Margin" Value="0,0,3,0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="9">
                        <Path x:Name="Cross" Data="M5,5 L13,13 M13,5 L5,13" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ToolHoverBrush}" />
                            <Setter TargetName="Cross" Property="Stroke" Value="{DynamicResource HeadingBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ToolPressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bouton icône seule : son infobulle lui sert de nom pour les lecteurs d'écran. -->
    <Style x:Key="SmallToolButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
    </Style>

    <Style x:Key="SmallIcon" TargetType="Image">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
    </Style>

    <!-- Croix d'un onglet : zone cliquable d'environ 22 px ; au clavier, Ctrl+F4 ferme l'onglet. -->
    <Style x:Key="TabCloseButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="Margin" Value="4,-2,-8,-2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
    </Style>

    <Style x:Key="ToolIcon" TargetType="Image">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ToolLabel" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ToolSeparator" TargetType="Rectangle">
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="6,6" />
        <Setter Property="Fill" Value="{DynamicResource ToolbarBorderBrush}" />
    </Style>

    <!-- Onglets verticaux du bandeau latéral (« Sessions », « Favoris »). -->
    <!-- L'en-tête et le contenu héritent tous deux de Foreground (arbre logique) : le contenu de chaque
         onglet latéral fixe donc sa propre couleur de texte (SidePanelForeground). -->
    <Style x:Key="SideTabItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource SideStripForeground}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Margin="0,0,0,2">
                        <Border x:Name="Bd" Background="Transparent" Padding="7,14" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center">
                                <ContentPresenter.LayoutTransform>
                                    <RotateTransform Angle="-90" />
                                </ContentPresenter.LayoutTransform>
                            </ContentPresenter>
                        </Border>
                        <!-- Onglet choisi : une barre claire en plus de la couleur (contraste avec le bandeau). -->
                        <Border x:Name="Marker" Width="4" HorizontalAlignment="Left" Background="Transparent" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SideStripHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Marker" Property="Background" Value="{DynamicResource SideStripMarkerBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource SideStripSelectedForeground}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SideStripFocusBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SideTabControl" TargetType="TabControl">
        <Setter Property="TabStripPlacement" Value="Left" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SideTabItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border x:Name="SideStrip" DockPanel.Dock="Left" Background="{DynamicResource SideStripBrush}">
                            <StackPanel IsItemsHost="True" Margin="0,4,0,0" />
                        </Border>
                        <Border x:Name="SidePanelContent" Background="{DynamicResource SidePanelBrush}" BorderBrush="{DynamicResource ToolbarBorderBrush}"
                                BorderThickness="0,0,1,0">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Onglets de la zone principale (« Accueil », sessions SSH et Bureau à distance). Couleur du texte donnée ici : celle
         du style de Windows est un noir écrit en dur, illisible sur le fond sombre ou contrasté de l'onglet. -->
    <Style x:Key="MainTabItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Background="{DynamicResource MainTabBrush}" BorderBrush="{DynamicResource MainTabBorderBrush}" BorderThickness="1,1,1,0"
                            CornerRadius="5,5,0,0" Padding="12,5,14,5" Margin="0,0,3,-1">
                        <Grid>
                            <Border x:Name="Accent" Height="3" VerticalAlignment="Top" Margin="-12,-5,-14,0"
                                    CornerRadius="5,5,0,0" Background="Transparent" />
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MainTabHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ContentBrush}" />
                            <Setter TargetName="Accent" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Panel.ZIndex" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MainTabControl" TargetType="TabControl">
        <Setter Property="ItemContainerStyle" Value="{StaticResource MainTabItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{DynamicResource TabStripBrush}" Padding="6,6,6,0"
                                BorderBrush="{DynamicResource MainTabBorderBrush}" BorderThickness="0,0,0,1">
                            <!-- Trop d'onglets : la bande défile (molette, onglet choisi toujours visible) et « ⌄ » les liste
                                 tous (MainWindow.Tabs.cs). -->
                            <DockPanel>
                                <Button x:Name="TabListButton" DockPanel.Dock="Right" Style="{StaticResource SmallToolButton}"
                                        Margin="4,0,0,3" VerticalAlignment="Center" Visibility="Collapsed">
                                    <Path Data="M0,0 L5,5 L10,0" Stroke="{DynamicResource SidePanelForeground}" StrokeThickness="1.8"
                                          Width="10" Height="6" Margin="3,4" />
                                </Button>
                                <ScrollViewer x:Name="TabScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                              Focusable="False" Margin="0,0,0,-1">
                                    <StackPanel IsItemsHost="True" Orientation="Horizontal" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <Border Background="{DynamicResource ContentBrush}">
                            <Grid>
                                <ContentPresenter ContentSource="SelectedContent" />
                                <!-- Onglets Bureau à distance : leur contenu reste ici en permanence (seulement masqué), pour que
                                     le contrôle Bureau à distance ne soit jamais retiré de la fenêtre pendant la session. -->
                                <Grid x:Name="RdpLayer" />
                            </Grid>
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bouton d'une action irréversible (supprimer, remplacer une clé) : rouge, jamais bouton par défaut. -->
    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="MinWidth" Value="90" />
        <Setter Property="Foreground" Value="{DynamicResource DangerForeground}" />
        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DangerFocusBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Lignes des listes de fichiers (onglet Fichiers, choix d'un fichier du serveur), en DynamicResource : le thème
         sombre la remplace (ThemeDark.xaml) par une ligne sans les dégradés clairs du style de Windows. -->
    <Style x:Key="FileRow" TargetType="ListViewItem">
        <Setter Property="Padding" Value="2,1" />
        <!-- Dossier survolé pendant un dépôt de fichiers : il recevra les fichiers (FileBrowserPanel). -->
        <Style.Triggers>
            <Trigger Property="Tag" Value="drop">
                <Setter Property="Background" Value="{DynamicResource AccentLightBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Texte secondaire d'une ligne d'arbre (nombre, mode, « correspond : … », ⚠, ✓) : sur la ligne sélectionnée, avec ou
         sans le focus, il prend la couleur du texte de la ligne, faite pour le fond de la sélection (couleur de Windows,
         contraste élevé compris) ; sa couleur propre y serait illisible. Le texte ou le symbole garde le sens. -->
    <Style x:Key="TreeNote" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TreeWarning" TargetType="TextBlock" BasedOn="{StaticResource TreeNote}">
        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    </Style>
    <Style x:Key="TreeAccent" TargetType="TextBlock" BasedOn="{StaticResource TreeNote}">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- ===== Kit des dialogues ===== -->
    <!-- Bandeau d'erreur (réponse du PVWA, échec de connexion) : le texte est une ErrorLine, annoncée. -->
    <Style x:Key="ErrorBanner" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ErrorBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <!-- Bandeau d'avertissement (FTP en clair, accès d'urgence…). -->
    <Style x:Key="WarningBanner" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <!-- Pied des dialogues : fond du panneau, filet en haut, boutons à droite (principal puis Annuler/Fermer). -->
    <Style x:Key="DialogFooter" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SidePanelBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToolbarBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="16,10,16,12" />
    </Style>

    <!-- Conséquence d'une option sensible, sous sa case (« ⚠ Effet : … »). -->
    <Style x:Key="OptionEffect" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="20,0,0,8" />
    </Style>

    <!-- La même, affichée dès que sa case (Tag) est cochée et active : visible au clavier, pas seulement au survol. -->
    <Style x:Key="CheckedOptionEffect" TargetType="TextBlock" BasedOn="{StaticResource OptionEffect}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Tag.IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding Tag.IsEnabled, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Aide sous un réglage. -->
    <Style x:Key="OptionHelp" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="20,0,0,8" />
    </Style>

    <!-- Bloc de texte à espacement fixe (empreintes, chemins) : sélectionnable, sans bordure. -->
    <Style x:Key="CodeBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="Consolas, Courier New" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Background" Value="{DynamicResource CodeBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CodeBorderBrush}" />
        <Setter Property="Padding" Value="6,4" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource HeadingBrush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- Texte indicatif affiché dans une zone de saisie vide : Tag = TextBox ciblée. -->
    <Style x:Key="Placeholder" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PlaceholderBrush}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag.Text, RelativeSource={RelativeSource Self}}" Value="">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Contrôles standard ===== -->
    <!-- Marges des champs et des boutons (le thème sombre, ThemeDark.xaml, reprend ces valeurs avec ses propres modèles). -->
    <Style TargetType="TextBox">
        <Setter Property="Padding" Value="4,3" />
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="Padding" Value="4,3" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="6,4" />
    </Style>
    <Style TargetType="Button">
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="MinWidth" Value="90" />
    </Style>
</ResourceDictionary>
