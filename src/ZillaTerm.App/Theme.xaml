<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette : barre d'outils claire, bandeau latéral sombre, accent bleu. Toutes les couleurs de l'interface sont ici,
         référencées en DynamicResource : en contraste élevé, Palette.cs les remplace par les couleurs système de Windows. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#1565C0" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="#E3EEFB" />
    <SolidColorBrush x:Key="ToolbarBorderBrush" Color="#C9D1DA" />
    <SolidColorBrush x:Key="SideStripBrush" Color="#2B3A4A" />
    <SolidColorBrush x:Key="SidePanelBrush" Color="#F7F9FB" />
    <SolidColorBrush x:Key="TabStripBrush" Color="#DCE3EA" />
    <SolidColorBrush x:Key="StatusBrush" Color="#2B3A4A" />
    <!-- Texte secondaire : 5,6:1 sur le panneau latéral (seuil 4,5:1). -->
    <SolidColorBrush x:Key="MutedBrush" Color="#5A6573" />
    <SolidColorBrush x:Key="SidePanelForeground" Color="#1F2933" />
    <!-- Fond des zones de contenu (onglets, comparaison, suivi tail -f). -->
    <SolidColorBrush x:Key="ContentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HeadingBrush" Color="#2B3A4A" />
    <!-- 4,6:1 sur blanc : le texte indicatif sert de libellé aux champs de recherche. -->
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#6B7785" />

    <!-- Boutons de la barre d'outils. -->
    <SolidColorBrush x:Key="ToolHoverBrush" Color="#DCE8F5" />
    <SolidColorBrush x:Key="ToolHoverBorderBrush" Color="#A9C7E8" />
    <SolidColorBrush x:Key="ToolPressedBrush" Color="#C4DBF2" />
    <SolidColorBrush x:Key="ToolFocusBrush" Color="#E8F1FB" />

    <!-- Bandeau latéral (onglets verticaux). -->
    <SolidColorBrush x:Key="SideStripForeground" Color="#C8D3DE" />
    <SolidColorBrush x:Key="SideStripHoverBrush" Color="#3A4D61" />
    <SolidColorBrush x:Key="SideStripMarkerBrush" Color="#64B5F6" />
    <SolidColorBrush x:Key="SideStripSelectedForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SideStripFocusBrush" Color="#FFFFFF" />

    <!-- Onglets de la zone principale et barres des sessions Bureau à distance / VNC. -->
    <SolidColorBrush x:Key="MainTabBrush" Color="#EEF2F6" />
    <SolidColorBrush x:Key="MainTabBorderBrush" Color="#BAC5D1" />
    <SolidColorBrush x:Key="MainTabHoverBrush" Color="#F6F8FA" />

    <!-- Pastille d'état des onglets de session (éléments graphiques : 3:1 au moins sur l'onglet). -->
    <SolidColorBrush x:Key="StateConnectedBrush" Color="#2E7D32" />
    <SolidColorBrush x:Key="StateConnectingBrush" Color="#B26A00" />
    <SolidColorBrush x:Key="StateEndedBrush" Color="#6B7785" />
    <SolidColorBrush x:Key="StateFailedBrush" Color="#C62828" />
    <!-- « ! » sur la pastille rouge (onglet Fichiers, historique des transferts). -->
    <SolidColorBrush x:Key="BadgeForeground" Color="#FFFFFF" />

    <!-- Barre d'état (fond sombre). -->
    <SolidColorBrush x:Key="StatusForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="StatusMutedForeground" Color="#C8D3DE" />
    <SolidColorBrush x:Key="StatusOkForeground" Color="#9FD39F" />
    <SolidColorBrush x:Key="StatusErrorForeground" Color="#FFB4A9" />
    <SolidColorBrush x:Key="StatusWarningForeground" Color="#F2C14E" />

    <!-- Messages : erreur, avertissement, réussite (texte, fond et bordure des bandeaux). -->
    <SolidColorBrush x:Key="ErrorBrush" Color="#A4262C" />
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FDECEA" />
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#F5C2BD" />
    <SolidColorBrush x:Key="WarningBrush" Color="#8F5600" />
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FFF4CE" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#E0C068" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#1E7B45" />

    <!-- Bouton d'une action irréversible. -->
    <SolidColorBrush x:Key="DangerBrush" Color="#B3261E" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#C93A31" />
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#8C1D18" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#8C1D18" />
    <SolidColorBrush x:Key="DangerForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DangerFocusBrush" Color="#1F2933" />

    <!-- Tableaux, texte à espacement fixe, comparaison de fichiers, diffusion de la vue parallèle. -->
    <SolidColorBrush x:Key="GridLineBrush" Color="#E5E9EE" />
    <SolidColorBrush x:Key="AlternateRowBrush" Color="#F7F9FC" />
    <SolidColorBrush x:Key="CodeBrush" Color="#F3F5F7" />
    <SolidColorBrush x:Key="CodeBorderBrush" Color="#D5DCE3" />
    <SolidColorBrush x:Key="DiffRemovedBrush" Color="#FDE2E1" />
    <SolidColorBrush x:Key="DiffAddedBrush" Color="#DCF5E0" />
    <SolidColorBrush x:Key="DiffEmptyBrush" Color="#F1F3F5" />
    <SolidColorBrush x:Key="DiffRemovedForeground" Color="#B42318" />
    <SolidColorBrush x:Key="DiffAddedForeground" Color="#1E7B34" />
    <SolidColorBrush x:Key="DiffTextBrush" Color="#1F2933" />
    <SolidColorBrush x:Key="LineNumberBrush" Color="#6B7785" />
    <SolidColorBrush x:Key="BroadcastBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="BroadcastForeground" Color="#1F1300" />
    <SolidColorBrush x:Key="DropHintBrush" Color="#E8E3EEFB" />

    <!-- Sélection toujours visible quand la liste n'a pas le focus (menu contextuel ouvert, clic ailleurs) :
         le gris « inactif » de Windows se confond avec le fond des panneaux. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#CCE4F7" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1F2933" />
    <LinearGradientBrush x:Key="ToolbarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FBFCFD" Offset="0" />
        <GradientStop Color="#E8EDF2" Offset="1" />
    </LinearGradientBrush>

