<views:DialogWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:ZillaTerm.App.Views"
                    xmlns:loc="clr-namespace:ZillaTerm.App.Localization"
                    x:Class="ZillaTerm.App.Views.PermissionsDialog"
                    Title="{x:Static loc:Strings.PermissionsTitle}" Width="440" SizeToContent="Height" CanResize="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="TargetText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <!-- Serveur et dossier : l'onglet Fichiers change de serveur avec l'onglet de session actif. -->
        <TextBlock x:Name="PathText" Classes="Muted" TextTrimming="CharacterEllipsis" Margin="0,2,0,12"
                   ToolTip.Tip="{Binding $self.Text}" />
        <TextBlock x:Name="MixedText" Text="{x:Static loc:Strings.PermissionsMixedHint}" TextWrapping="Wrap" Margin="0,0,0,10"
                   IsVisible="False" />

        <!-- Cases rwx : une ligne par catégorie, une colonne par droit. -->
        <Grid x:Name="BitsGrid" Margin="0,0,0,12" ColumnDefinitions="110,*,*,*" RowDefinitions="Auto,26,26,26">
            <TextBlock Grid.Column="1" Text="{x:Static loc:Strings.PermissionsRead}" Classes="Muted" HorizontalAlignment="Center" Margin="0,0,0,4" />
            <TextBlock Grid.Column="2" Text="{x:Static loc:Strings.PermissionsWrite}" Classes="Muted" HorizontalAlignment="Center" Margin="0,0,0,4" />
            <TextBlock Grid.Column="3" Text="{x:Static loc:Strings.PermissionsExecute}" Classes="Muted" HorizontalAlignment="Center" Margin="0,0,0,4" />
            <TextBlock Grid.Row="1" Text="{x:Static loc:Strings.PermissionsOwner}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="2" Text="{x:Static loc:Strings.PermissionsGroup}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="3" Text="{x:Static loc:Strings.PermissionsOthers}" VerticalAlignment="Center" />
        </Grid>

        <DockPanel Margin="0,0,0,10">
            <TextBlock Text="{x:Static loc:Strings.PermissionsSpecial}" Width="110" VerticalAlignment="Center" />
            <CheckBox x:Name="SetUidBox" Content="setuid" ToolTip.Tip="{x:Static loc:Strings.SetUidTip}" Margin="0,0,16,0" Click="OnBoxClick" />
            <CheckBox x:Name="SetGidBox" Content="setgid" ToolTip.Tip="{x:Static loc:Strings.SetGidTip}" Margin="0,0,16,0" Click="OnBoxClick" />
            <CheckBox x:Name="StickyBox" Content="sticky" ToolTip.Tip="{x:Static loc:Strings.StickyTip}" Click="OnBoxClick" />
        </DockPanel>

        <DockPanel Margin="0,0,0,8">
            <Label Content="{x:Static loc:Strings.PermissionsOctal}" Target="{Binding #OctalBox}" Width="110" Padding="0,4" VerticalAlignment="Center" />
            <TextBox x:Name="OctalBox" Width="70" HorizontalAlignment="Left" FontFamily="{StaticResource MonospaceFont}" MaxLength="4"
                     TextChanged="OnOctalChanged" VerticalContentAlignment="Center" />
            <TextBlock x:Name="SymbolicText" FontFamily="{StaticResource MonospaceFont}" Classes="Muted" VerticalAlignment="Center" Margin="12,0,0,0" />
        </DockPanel>

        <StackPanel x:Name="RecursivePanel" IsVisible="False" Margin="0,4,0,8">
            <CheckBox x:Name="RecursiveBox" Click="OnRecursiveClick">
                <AccessText Text="{x:Static loc:Strings.PermissionsRecursive}" TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox x:Name="SmartExecuteBox" IsChecked="True" IsEnabled="False" Margin="20,6,0,0">
                <AccessText Text="{x:Static loc:Strings.PermissionsSmartExecute}" TextWrapping="Wrap" />
            </CheckBox>
        </StackPanel>

        <TextBlock Text="{x:Static loc:Strings.PermissionsHint}" Classes="Muted" TextWrapping="Wrap" Margin="0,0,0,8" />
        <views:ErrorLine x:Name="ErrorText" IsVisible="False" Margin="0,0,0,8" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Classes="DialogButtons">
            <Button x:Name="OkButton" Content="{x:Static loc:Strings.PermissionsApply}" IsDefault="True" Click="OnOk" />
            <Button Content="{x:Static loc:Strings.Cancel}" IsCancel="True" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</views:DialogWindow>
