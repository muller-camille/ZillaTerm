<views:DialogWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:ZillaTerm.App.Views"
                    xmlns:loc="clr-namespace:ZillaTerm.App.Localization"
                    x:Class="ZillaTerm.App.Views.InputDialog"
                    Width="400" SizeToContent="Height" CanResize="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="LabelText" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBox x:Name="ValueBox" Margin="0,0,0,8" AutomationProperties.LabeledBy="{Binding #LabelText}" />
        <views:ErrorLine x:Name="ErrorText" IsVisible="False" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Classes="DialogButtons">
            <Button Content="{x:Static loc:Strings.Ok}" IsDefault="True" Click="OnOk" />
            <Button Content="{x:Static loc:Strings.Cancel}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</views:DialogWindow>
