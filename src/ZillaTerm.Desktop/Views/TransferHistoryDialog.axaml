<views:DialogWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:ZillaTerm.App.Views"
                    xmlns:loc="clr-namespace:ZillaTerm.App.Localization"
                    x:Class="ZillaTerm.App.Views.TransferHistoryDialog"
                    Title="{x:Static loc:Strings.HistoryTitle}" Width="1100" Height="540" MinWidth="640" MinHeight="300">
    <views:DialogWindow.Styles>
        <!-- Texte tronqué (« … ») et complet dans l'infobulle : serveur, élément et destination peuvent être longs. -->
        <Style Selector="DataGrid#RecordsGrid DataGridCell TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip.Tip" Value="{Binding $self.Text}" />
        </Style>
        <!-- Transfert en échec ou fichier différent de l'original : ligne en rouge. -->
        <Style Selector="DataGridRow.Problem">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </views:DialogWindow.Styles>
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <ComboBox x:Name="FilterBox" DockPanel.Dock="Left" MinWidth="180" Margin="0,0,12,0" SelectedIndex="0"
                      AutomationProperties.Name="{x:Static loc:Strings.A11yHistoryFilter}">
                <ComboBoxItem Content="{x:Static loc:Strings.HistoryFilterAll}" />
                <ComboBoxItem Content="{x:Static loc:Strings.HistoryFilterUploads}" />
                <ComboBoxItem Content="{x:Static loc:Strings.HistoryFilterDownloads}" />
                <ComboBoxItem Content="{x:Static loc:Strings.HistoryFilterProblems}" />
            </ComboBox>
            <TextBlock Text="{x:Static loc:Strings.HistoryNote}" Classes="Muted" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="{x:Static loc:Strings.CloseButton}" IsCancel="True" Margin="8,0,0,0" MinWidth="90"
                    HorizontalContentAlignment="Center" />
            <StackPanel Orientation="Horizontal" Classes="DialogButtons">
                <Button x:Name="ChecksButton" Content="{x:Static loc:Strings.HistoryChecks}" Click="OnChecks" IsEnabled="False" />
                <Button x:Name="OpenFolderButton" Content="{x:Static loc:Strings.HistoryOpenFolder}" Click="OnOpenFolder" IsEnabled="False" Margin="8,0,0,0" />
                <!-- Action destructive à l'écart des autres. -->
                <Button x:Name="ClearButton" Content="{x:Static loc:Strings.HistoryClear}" Click="OnClear" Margin="32,0,0,0" />
            </StackPanel>
        </DockPanel>

        <Panel>
            <DataGrid x:Name="RecordsGrid" Classes="Records" SelectionMode="Single" DoubleTapped="OnRowDoubleClick" />
            <TextBlock x:Name="EmptyText" Text="{x:Static loc:Strings.HistoryEmpty}" Classes="Muted"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />
        </Panel>
    </DockPanel>
</views:DialogWindow>
