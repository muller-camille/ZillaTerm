<views:DialogWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:ZillaTerm.App.Views"
                    xmlns:loc="clr-namespace:ZillaTerm.App.Localization"
                    x:Class="ZillaTerm.App.Views.SessionPropertiesDialog"
                    Title="{x:Static loc:Strings.PropertiesTitle}" Width="540" SizeToContent="Height" CanResize="False">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource ToolbarBrush}" BorderBrush="{DynamicResource ToolbarBorderBrush}"
                BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel>
                <Image x:Name="KindIcon" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="AccountText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DetailsText" Classes="Muted" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel DockPanel.Dock="Bottom" Margin="16,4,16,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="8" Classes="DialogButtons">
                <Button Content="{x:Static loc:Strings.Save}" IsDefault="True" Click="OnSave" />
                <Button Content="{x:Static loc:Strings.Cancel}" IsCancel="True" />
            </StackPanel>
            <views:ErrorLine x:Name="ErrorText" IsVisible="False" VerticalAlignment="Center" Margin="0,0,12,0" />
        </DockPanel>

        <Grid Margin="16,12,16,8" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <!-- Étiquettes à la largeur du plus long texte (italien). -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.ColumnSpan="2" Text="{x:Static loc:Strings.DisplaySection}" Classes="SectionTitle" />
            <Label Grid.Row="1" Content="{x:Static loc:Strings.NameLabel}" Target="{Binding #NameBox}" Margin="0,0,8,8" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="NameBox" Margin="0,0,0,8" />
            <Label Grid.Row="2" Content="{x:Static loc:Strings.FolderLabel}" Target="{Binding #FolderBox}" Margin="0,0,8,8"
                   VerticalAlignment="Center" />
            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="FolderBox" IsEditable="True" Margin="0,0,0,8" HorizontalAlignment="Stretch"
                      ToolTip.Tip="{x:Static loc:Strings.FolderTip}" />
            <!-- Étiquette d'environnement (PROD, QA…) : sa couleur marque l'onglet et la session. -->
            <Label Grid.Row="3" Content="{x:Static loc:Strings.TagLabel}" Target="{Binding #TagBox}" Margin="0,0,8,12" VerticalAlignment="Center" />
            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="TagBox" Margin="0,0,0,12" HorizontalAlignment="Left" MinWidth="160"
                      ToolTip.Tip="{x:Static loc:Strings.TagTip}" />

            <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{x:Static loc:Strings.ConnectionSection}" Classes="SectionTitle" />
            <Label Grid.Row="5" x:Name="ModeLabel" Content="{x:Static loc:Strings.ConnectionTypeLabel}" Target="{Binding #PsmRadio}"
                   Margin="0,0,8,8" VerticalAlignment="Top" />
            <WrapPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,8">
                <RadioButton x:Name="PsmRadio" Content="{x:Static loc:Strings.ModePsm}" GroupName="Mode" Margin="0,0,24,4"
                             IsCheckedChanged="OnModeChanged" AutomationProperties.LabeledBy="{Binding #ModeLabel}" />
                <RadioButton x:Name="SshRadio" Content="{x:Static loc:Strings.ModeSsh}" GroupName="Mode" Margin="0,0,24,4"
                             IsCheckedChanged="OnModeChanged" AutomationProperties.LabeledBy="{Binding #ModeLabel}" />
                <RadioButton x:Name="SftpRadio" Content="{x:Static loc:Strings.ModeSftp}" GroupName="Mode" Margin="0,0,0,4"
                             IsCheckedChanged="OnModeChanged" AutomationProperties.LabeledBy="{Binding #ModeLabel}" />
            </WrapPanel>
            <Label Grid.Row="6" Content="{x:Static loc:Strings.ComponentLabel}" Target="{Binding #ComponentBox}" Margin="0,0,8,8"
                   VerticalAlignment="Center" />
            <ComboBox Grid.Row="6" Grid.Column="1" x:Name="ComponentBox" IsEditable="True" Margin="0,0,0,8" HorizontalAlignment="Stretch"
                      ToolTip.Tip="{x:Static loc:Strings.ComponentEmptyTip}" />
            <Label Grid.Row="7" Content="{x:Static loc:Strings.TargetMachineLabel}" Target="{Binding #MachineBox}" Margin="0,0,8,8"
                   VerticalAlignment="Center" />
            <ComboBox Grid.Row="7" Grid.Column="1" x:Name="MachineBox" IsEditable="True" Margin="0,0,0,8" HorizontalAlignment="Stretch" />
            <Label Grid.Row="8" Content="{x:Static loc:Strings.DefaultReasonLabel}" Target="{Binding #ReasonBox}" Margin="0,0,8,8"
                   VerticalAlignment="Center" />
            <TextBox Grid.Row="8" Grid.Column="1" x:Name="ReasonBox" Margin="0,0,0,8" />
            <Label Grid.Row="9" Content="{x:Static loc:Strings.StartDirLabel}" Target="{Binding #StartDirBox}" Margin="0,0,8,8"
                   VerticalAlignment="Center" />
            <TextBox Grid.Row="9" Grid.Column="1" x:Name="StartDirBox" Margin="0,0,0,8"
                     ToolTip.Tip="{x:Static loc:Strings.StartDirTip}" />
            <CheckBox Grid.Row="10" Grid.Column="1" x:Name="X11Box" Margin="0,0,0,8" ToolTip.Tip="{x:Static loc:PlatformText.X11ForwardingTip}"
                      ToolTip.ShowOnDisabled="True">
                <AccessText Text="{x:Static loc:Strings.X11Forwarding}" TextWrapping="Wrap" />
            </CheckBox>
            <!-- Conséquence de l'option, affichée dès que sa case est cochée et active. -->
            <TextBlock Grid.Row="11" Grid.Column="1" x:Name="X11Effect" Classes="OptionEffect" Margin="20,-6,0,8"
                       Text="{x:Static loc:Strings.X11ForwardingEffect}">
                <TextBlock.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding ElementName="X11Box" Path="IsChecked" />
                        <Binding ElementName="X11Box" Path="IsEffectivelyEnabled" />
                    </MultiBinding>
                </TextBlock.IsVisible>
            </TextBlock>
        </Grid>
    </DockPanel>
</views:DialogWindow>
