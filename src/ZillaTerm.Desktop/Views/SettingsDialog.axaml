<views:DialogWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:ZillaTerm.App.Views"
                    xmlns:loc="clr-namespace:ZillaTerm.App.Localization"
                    xmlns:core="clr-namespace:ZillaTerm.Core;assembly=ZillaTerm.Core"
                    x:Class="ZillaTerm.App.Views.SettingsDialog"
                    Title="{x:Static loc:Strings.SettingsTitle}"
                    Width="780" Height="560" MinWidth="640" MinHeight="420">
    <views:DialogWindow.Styles>
        <!-- Tableaux : thème du paquet Avalonia.Controls.DataGrid (Fluent), resserré. -->
        <StyleInclude Source="avares://ZillaTerm/Themes/CompactDataGrid.axaml" />
        <!-- Libellés des champs : alignés sur le champ, comme sous Windows. -->
        <Style Selector="Label">
            <Setter Property="Padding" Value="0,3,8,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </views:DialogWindow.Styles>

    <views:DialogWindow.Resources>
        <!-- Pages à gauche, sur le modèle des onglets des dialogues de l'application WPF : onglet choisi sur le fond de la
             page, barre d'accent à gauche. -->
        <ControlTheme x:Key="PageTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource SidePanelForeground}" />
            <Setter Property="Background" Value="{DynamicResource MainTabBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MainTabBorderBrush}" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinWidth" Value="130" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel Margin="0,0,0,2">
                        <Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,0,1" CornerRadius="3,0,0,3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}" RecognizesAccessKey="True"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <Border Name="Accent" Width="3" HorizontalAlignment="Left" CornerRadius="3,0,0,3" Background="Transparent" />
                    </Panel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#Bd">
                <Setter Property="Background" Value="{DynamicResource MainTabHoverBrush}" />
            </Style>
            <Style Selector="^:selected /template/ Border#Bd">
                <Setter Property="Background" Value="{DynamicResource ContentBrush}" />
            </Style>
            <Style Selector="^:selected /template/ Border#Accent">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            </Style>
            <Style Selector="^:focus-visible /template/ Border#Bd">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="PageTabControl" TargetType="TabControl">
            <Setter Property="ItemContainerTheme" Value="{StaticResource PageTabItem}" />
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <DockPanel>
                        <ItemsPresenter Name="PART_ItemsPresenter" DockPanel.Dock="Left" ItemsPanel="{TemplateBinding ItemsPanel}" Margin="0,2,0,0" />
                        <Border Background="{DynamicResource ContentBrush}" BorderBrush="{DynamicResource MainTabBorderBrush}" BorderThickness="1">
                            <Panel>
                                <ContentPresenter Name="PART_SelectedContentHost2" IsVisible="False" />
                                <ContentPresenter Name="PART_SelectedContentHost" Margin="{TemplateBinding Padding}" />
                            </Panel>
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </views:DialogWindow.Resources>

    <!-- Une page par thème (onglets à gauche, Ctrl+Tab de l'une à l'autre) ; chaque page défile si besoin. Les réglages
         s'appliquent avec « Enregistrer » ; seules les actions du coffre local sont immédiates, et le disent. -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="DialogFooter">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="8">
                    <Button Content="{x:Static loc:Strings.Save}" IsDefault="True" Click="OnSave" />
                    <Button Content="{x:Static loc:Strings.Cancel}" IsCancel="True" />
                </StackPanel>
                <views:ErrorLine x:Name="ErrorText" IsVisible="False" Margin="0,0,16,0" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <TabControl x:Name="Pages" Theme="{StaticResource PageTabControl}" Margin="10,10,10,8" Padding="0">

            <!-- ===== Général ===== -->
            <TabItem x:Name="GeneralPage" Header="{x:Static loc:Strings.SettingsPageGeneral}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,12">
                        <TextBlock Text="{x:Static loc:Strings.LanguageSection}" Classes="SectionTitle" />
                        <Grid Margin="0,0,0,16" RowDefinitions="Auto,Auto">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Content="{x:Static loc:Strings.LanguageLabel}" Target="{Binding #LanguageBox}" />
                            <ComboBox Grid.Column="1" x:Name="LanguageBox" VerticalAlignment="Center" MaxWidth="320" HorizontalAlignment="Left" MinWidth="220" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Static loc:Strings.LanguageHelp}" Classes="Muted"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                        </Grid>

                        <TextBlock Text="{x:Static loc:Strings.AppearanceSection}" Classes="SectionTitle" />
                        <Grid Margin="0,0,0,16" RowDefinitions="Auto,Auto">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Content="{x:Static loc:Strings.AppThemeLabel}" Target="{Binding #AppThemeBox}" />
                            <ComboBox Grid.Column="1" x:Name="AppThemeBox" VerticalAlignment="Center" MaxWidth="320" HorizontalAlignment="Left" MinWidth="220" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Static loc:Strings.AppThemeHelp}" Classes="Muted"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                        </Grid>

                        <TextBlock Text="{x:Static loc:Strings.SettingsUpdatesSection}" Classes="SectionTitle" />
                        <CheckBox x:Name="UpdateCheckBox" Margin="0,0,0,16">
                            <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.AboutAutoCheck}" />
                        </CheckBox>

                        <!-- Environnement d'équipe : fichier central relu à chaque démarrage (voir EnvironmentImport). -->
                        <TextBlock Text="{x:Static loc:Strings.EnvTitle}" Classes="SectionTitle" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label Content="{x:Static loc:Strings.CentralFileLabel}" Target="{Binding #CentralFileBox}" />
                            <TextBox Grid.Column="1" x:Name="CentralFileBox" VerticalContentAlignment="Center" />
                            <Button Grid.Column="2" Content="{x:Static loc:Strings.Browse}" Click="OnBrowseCentralFile" Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock Classes="OptionHelp" Margin="0,0,0,16" Text="{x:Static loc:Strings.CentralFileHelp}" />

                        <!-- Astreinte : consignes de l'équipe (texte ou fichier), diffusées par le fichier d'environnement. -->
                        <TextBlock Text="{x:Static loc:Strings.DutySection}" Classes="SectionTitle" />
                        <Label Content="{x:Static loc:Strings.DutyTextLabel}" Target="{Binding #DutyTextBox}" Padding="0,0,0,4" />
                        <TextBox x:Name="DutyTextBox" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" MinHeight="96" MaxHeight="220"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" MaxLength="8000" />
                        <TextBlock Classes="OptionHelp" Margin="0,4,0,8" Text="{x:Static loc:Strings.DutyTextHelp}" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label Content="{x:Static loc:Strings.DutyFileLabel}" Target="{Binding #DutyFileBox}" />
                            <TextBox Grid.Column="1" x:Name="DutyFileBox" VerticalContentAlignment="Center" MaxLength="1024" />
                            <Button Grid.Column="2" Content="{x:Static loc:Strings.Browse}" Click="OnBrowseDutyFile" Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock Classes="OptionHelp" Margin="0,0,0,8" Text="{x:Static loc:Strings.DutyFileHelp}" />
                        <!-- Rappels pendant l'intervention : une ligne par rappel, minutes depuis le début puis le texte. -->
                        <Label Content="{x:Static loc:Strings.RemindersLabel}" Target="{Binding #RemindersBox}" Padding="0,0,0,4" />
                        <TextBox x:Name="RemindersBox" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" MinHeight="58" MaxHeight="160"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" MaxLength="2400" FontFamily="{StaticResource MonospaceFont}"
                                 AutomationProperties.HelpText="{x:Static loc:Strings.RemindersHelp}" />
                        <TextBlock Classes="OptionHelp" Margin="0,4,0,16" Text="{x:Static loc:Strings.RemindersHelp}" />

                        <!-- Étiquettes des serveurs de « Mes serveurs » (PROD, QA, DEV…) : nom et couleur. -->
                        <TextBlock Text="{x:Static loc:Strings.ServerTagsSection}" Classes="SectionTitle" />
                        <TextBlock Classes="OptionHelp" Margin="0,0,0,6" Text="{x:Static loc:Strings.ServerTagsHelp}" />
                        <DataGrid x:Name="TagGrid" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserReorderColumns="False"
                                  CanUserSortColumns="False" SelectionMode="Single" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource GridLineBrush}" MinHeight="60" MaxHeight="220"
                                  SelectionChanged="OnTagSelected" AutomationProperties.Name="{x:Static loc:Strings.ServerTagsSection}">
                            <DataGrid.Columns>
                                <!-- Aperçu : la pastille telle qu'elle apparaîtra sur l'onglet. -->
                                <DataGridTemplateColumn Width="Auto" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="views:SettingsDialog+TagRow">
                                            <Border Background="{Binding Background}" CornerRadius="3" Padding="5,0,5,1" Margin="4,2"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="{Binding Foreground}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{x:Static loc:Strings.ServerTagColName}" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="views:SettingsDialog+TagRow">
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="6,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate x:DataType="views:SettingsDialog+TagRow">
                                            <TextBox Text="{Binding Name}" MaxLength="{x:Static core:ServerTagRules.MaxNameLength}"
                                                     VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{x:Static loc:Strings.ServerTagColColor}" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="views:SettingsDialog+TagRow">
                                            <ComboBox ItemsSource="{Binding Colors}" SelectedItem="{Binding Choice, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="2,1"
                                                      AutomationProperties.Name="{Binding ColorName}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="views:SettingsDialog+ColorChoice">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Rectangle Width="14" Height="14" Fill="{Binding Brush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,8" Spacing="8">
                            <Button x:Name="AddTagButton" Click="OnAddTag" ToolTip.ShowOnDisabled="True">
                                <AccessText Text="{x:Static loc:Strings.ServerTagAdd}" />
                            </Button>
                            <Button x:Name="RemoveTagButton" Click="OnRemoveTag" IsEnabled="False">
                                <AccessText Text="{x:Static loc:Strings.ServerTagRemove}" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== CyberArk ===== -->
            <TabItem x:Name="CyberArkPage" Header="{x:Static loc:Strings.SettingsPageCyberArk}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,12">
                        <TextBlock Text="{x:Static loc:Strings.PvwaSessionSection}" Classes="SectionTitle" />
                        <CheckBox x:Name="KeepAliveBox" Margin="0,0,0,2">
                            <AccessText TextWrapping="Wrap" Text="{x:Static loc:PlatformText.KeepAlive}" />
                        </CheckBox>
                        <TextBlock Classes="OptionEffect" Text="{x:Static loc:Strings.SettingsKeepAliveEffect}" Margin="20,0,0,16" />

                        <TextBlock Text="{x:Static loc:Strings.SettingsSshSection}" Classes="SectionTitle" />
                        <TextBlock Classes="Muted" TextWrapping="Wrap" Margin="0,0,0,10" Text="{x:Static loc:Strings.SettingsSshHelp}" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <Label Content="{x:Static loc:Strings.PsmpAddressLabel}" Target="{Binding #PsmpBox}" />
                            <TextBox Grid.Column="1" x:Name="PsmpBox" VerticalContentAlignment="Center" TextChanged="OnPsmpChanged" />
                            <Label Grid.Column="2" Content="{x:Static loc:Strings.PortLabel}" Target="{Binding #PortBox}" Margin="8,0,0,0" />
                            <TextBox Grid.Column="3" x:Name="PortBox" VerticalContentAlignment="Center" TextChanged="OnPsmpChanged" />
                        </Grid>
                        <TextBlock Classes="OptionHelp" Margin="0,0,0,12" Text="{x:Static loc:Strings.PsmpDefaultHelp}" />

                        <!-- Autres PSMP : chaque serveur passe par celui de son domaine le plus proche (voir PsmpRouting). -->
                        <TextBlock Text="{x:Static loc:Strings.PsmpListSection}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Classes="OptionHelp" Margin="0,0,0,6" Text="{x:Static loc:Strings.PsmpListHelp}" />
                        <DataGrid x:Name="PsmpGrid" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserReorderColumns="False"
                                  SelectionMode="Single" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource GridLineBrush}"
                                  MinHeight="80" MaxHeight="180" SelectionChanged="OnPsmpSelected"
                                  AutomationProperties.Name="{x:Static loc:Strings.PsmpListSection}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{x:Static loc:Strings.PsmpColumnAddress}" Width="2*"
                                                    x:DataType="views:SettingsDialog+PsmpRow" Binding="{Binding Address}" />
                                <DataGridTextColumn Header="{x:Static loc:Strings.PsmpColumnPort}" Width="60"
                                                    x:DataType="views:SettingsDialog+PsmpRow" Binding="{Binding Port}" />
                                <DataGridTextColumn Header="{x:Static loc:Strings.PsmpColumnDomain}" Width="2*"
                                                    x:DataType="views:SettingsDialog+PsmpRow" Binding="{Binding Domain}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,10" Spacing="8">
                            <Button Content="{x:Static loc:Strings.PsmpAdd}" Click="OnAddPsmp" />
                            <Button x:Name="RemovePsmpButton" Content="{x:Static loc:Strings.PsmpRemove}" Click="OnRemovePsmp" IsEnabled="False" />
                        </StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Content="{x:Static loc:Strings.PsmpTestLabel}" Target="{Binding #PsmpTestBox}" />
                            <TextBox Grid.Column="1" x:Name="PsmpTestBox" VerticalContentAlignment="Center" TextChanged="OnPsmpChanged" />
                        </Grid>
                        <views:AnnouncedText x:Name="PsmpTestText" Classes="OptionHelp" Margin="0,0,0,8" />
                        <TextBlock Classes="OptionEffect" Margin="0,0,0,16" Text="{x:Static loc:Strings.PsmpSecurityEffect}" />

                        <TextBlock Text="{x:Static loc:Strings.ComponentsSection}" Classes="SectionTitle" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Content="{x:Static loc:Strings.WindowsComponentLabel}" Target="{Binding #WindowsComponentBox}" />
                            <ComboBox Grid.Column="1" x:Name="WindowsComponentBox" IsEditable="True" MaxWidth="320" HorizontalAlignment="Left"
                                      MinWidth="220" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Classes="OptionHelp" Margin="0,0,0,10" Text="{x:Static loc:Strings.WindowsComponentHelp}" />
                        <!-- Onglet (client Bureau à distance intégré) ou Connexion Bureau à distance : choix propre à Windows,
                             masqué ailleurs (OnlyOnWindows), sa valeur reste dans les réglages. -->
                        <CheckBox x:Name="PsmDesktopInTabBox" Margin="0,0,0,2">
                            <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.PsmDesktopInTab}" />
                        </CheckBox>
                        <TextBlock x:Name="PsmDesktopInTabHelp" Classes="OptionHelp" Margin="22,0,0,10" Text="{x:Static loc:Strings.PsmDesktopInTabHelp}" />
                        <CheckBox x:Name="PsmDynamicResolutionBox" Margin="22,0,0,2" IsEnabled="{Binding #PsmDesktopInTabBox.IsChecked}">
                            <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.PsmDynamicResolution}" />
                        </CheckBox>
                        <TextBlock x:Name="PsmDynamicResolutionHelp" Classes="OptionHelp" Margin="44,0,0,10"
                                   Text="{x:Static loc:Strings.PsmDynamicResolutionHelp}" />
                        <!-- Onglet et Connexion Bureau à distance : jamais grisée. -->
                        <CheckBox x:Name="PsmRedirectDrivesBox" Margin="0,0,0,2">
                            <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.PsmRedirectDrives}" />
                        </CheckBox>
                        <TextBlock x:Name="PsmRedirectDrivesHelp" Classes="OptionHelp" Margin="22,0,0,10" Text="{x:Static loc:Strings.PsmRedirectDrivesHelp}" />
                        <!-- Composant par plateforme : prioritaire sur celui des comptes Windows (voir AppSettings.ResolveComponent). -->
                        <TextBlock Text="{x:Static loc:Strings.PlatformComponentsSection}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Classes="OptionHelp" Margin="0,0,0,6" Text="{x:Static loc:Strings.PlatformComponentsHelp}" />
                        <DataGrid x:Name="ComponentGrid" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserReorderColumns="False"
                                  SelectionMode="Single" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource GridLineBrush}"
                                  MinHeight="60" MaxHeight="180" SelectionChanged="OnComponentSelected"
                                  AutomationProperties.Name="{x:Static loc:Strings.PlatformComponentsSection}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{x:Static loc:Strings.ComponentColumnPlatform}" Width="*"
                                                    x:DataType="views:SettingsDialog+ComponentRow" Binding="{Binding Platform}" />
                                <DataGridTextColumn Header="{x:Static loc:Strings.ComponentColumnComponent}" Width="*"
                                                    x:DataType="views:SettingsDialog+ComponentRow" Binding="{Binding Component}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,8" Spacing="8">
                            <Button Content="{x:Static loc:Strings.ComponentAdd}" Click="OnAddComponent" />
                            <Button x:Name="RemoveComponentButton" Content="{x:Static loc:Strings.ComponentRemove}" Click="OnRemoveComponent"
                                    IsEnabled="False" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Terminal ===== -->
            <TabItem x:Name="TerminalPage" Header="{x:Static loc:Strings.SettingsPageTerminal}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,12">
                        <!-- Terminal de ZillaTerm ou Windows Terminal : choix propre à Windows, masqué ailleurs (OnlyOnWindows). -->
                        <CheckBox x:Name="SshInAppBox" Margin="0,0,0,12">
                            <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.SshInApp}" />
                        </CheckBox>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <Label Content="{x:Static loc:Strings.TerminalThemeLabel}" Target="{Binding #ThemeBox}" />
                            <ComboBox Grid.Column="1" x:Name="ThemeBox" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                            <Label Grid.Column="2" Content="{x:Static loc:Strings.TerminalFontLabel}" Target="{Binding #FontSizeBox}" Margin="8,0,0,0" />
                            <TextBox Grid.Column="3" x:Name="FontSizeBox" VerticalContentAlignment="Center" ToolTip.Tip="{x:Static loc:Strings.TerminalFontTip}" />
                        </Grid>
                        <CheckBox x:Name="ConfirmPasteBox" Margin="0,0,0,8">
                            <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.SettingsConfirmPaste}" />
                        </CheckBox>
                        <CheckBox x:Name="ConfirmCloseBox" Margin="0,0,0,8">
                            <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.SettingsConfirmClose}" />
                        </CheckBox>
                        <CheckBox x:Name="RightClickBox" Margin="0,0,0,2">
                            <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.SettingsRightClickPastes}" />
                        </CheckBox>
                        <TextBlock Classes="OptionEffect" Text="{x:Static loc:Strings.SettingsRightClickEffect}" />
                        <CheckBox x:Name="FollowBox" Margin="0,0,0,2">
                            <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.FollowSetting}" />
                        </CheckBox>
                        <TextBlock Classes="OptionEffect" Text="{x:Static loc:Strings.SettingsFollowEffect}" />

                        <TextBlock Text="{x:Static loc:Strings.X11Section}" Classes="SectionTitle" />
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="140" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <Label Content="{x:Static loc:Strings.X11DisplayLabel}" Target="{Binding #X11DisplayBox}" />
                            <TextBox Grid.Column="1" x:Name="X11DisplayBox" VerticalContentAlignment="Center" />
                        </Grid>
                        <TextBlock Classes="OptionHelp" Text="{x:Static loc:Strings.X11DisplayHelp}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Fichiers ===== -->
            <TabItem x:Name="FilesPage" Header="{x:Static loc:Strings.SettingsPageFiles}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,12">
                        <WrapPanel Margin="0,0,0,10" ToolTip.Tip="{x:Static loc:Strings.UploadProtocolTip}">
                            <Label x:Name="UploadLabel" Content="{x:Static loc:Strings.UploadLabel}" Target="{Binding #SftpRadio}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" Padding="0" />
                            <RadioButton x:Name="SftpRadio" Content="SFTP" GroupName="Upload" Margin="0,0,16,0" VerticalAlignment="Center"
                                         AutomationProperties.LabeledBy="{Binding #UploadLabel}" />
                            <RadioButton x:Name="ScpRadio" Content="SCP" GroupName="Upload" VerticalAlignment="Center"
                                         AutomationProperties.LabeledBy="{Binding #UploadLabel}" />
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,10" ToolTip.Tip="{x:Static loc:Strings.SettingsArchiveTip}">
                            <CheckBox x:Name="ArchiveBox" VerticalAlignment="Center">
                                <AccessText Text="{x:Static loc:Strings.SettingsArchiveOffer}" />
                            </CheckBox>
                            <TextBox x:Name="ArchiveThresholdBox" Width="60" Margin="6,0,6,0" VerticalAlignment="Center"
                                     IsEnabled="{Binding #ArchiveBox.IsChecked}" AutomationProperties.Name="{x:Static loc:Strings.A11yArchiveThreshold}" />
                            <TextBlock Text="{x:Static loc:Strings.SettingsArchiveFiles}" VerticalAlignment="Center" />
                        </WrapPanel>
                        <CheckBox x:Name="TailSessionBox" Margin="0,0,0,2">
                            <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.SettingsTailSession}" />
                        </CheckBox>
                        <TextBlock Classes="OptionHelp" Text="{x:Static loc:Strings.SettingsTailSessionHelp}" Margin="20,0,0,16" />

                        <Grid Margin="0,0,0,12" RowDefinitions="Auto,Auto">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label Content="{x:Static loc:Strings.TextEditorLabel}" Target="{Binding #EditorBox}" />
                            <TextBox Grid.Column="1" x:Name="EditorBox" VerticalContentAlignment="Center" />
                            <Button Grid.Column="2" Content="{x:Static loc:Strings.Browse}" Click="OnBrowseEditor" Margin="8,0,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{x:Static loc:PlatformText.TextEditorHelp}"
                                       Classes="Muted" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </Grid>
                        <!-- Outil de comparaison externe (facultatif) : la comparaison intégrée suffit sinon. -->
                        <Grid RowDefinitions="Auto,Auto,Auto">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label Content="{x:Static loc:Strings.CompareToolLabel}" Target="{Binding #CompareToolBox}" />
                            <TextBox Grid.Column="1" x:Name="CompareToolBox" VerticalContentAlignment="Center" />
                            <Button Grid.Column="2" Content="{x:Static loc:Strings.BrowseOther}" Click="OnBrowseCompareTool" Margin="8,0,0,0" />
                            <Label Grid.Row="1" Content="{x:Static loc:Strings.CompareArgumentsLabel}" Target="{Binding #CompareArgsBox}" Margin="0,4,0,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="CompareArgsBox" VerticalContentAlignment="Center" Margin="0,4,0,0"
                                     FontFamily="{StaticResource MonospaceFont}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{x:Static loc:PlatformText.CompareToolHelp}"
                                       Classes="Muted" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Partage de sessions ===== -->
            <TabItem x:Name="SharingPage" Header="{x:Static loc:Strings.SettingsPageSharing}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,12">
                        <CheckBox x:Name="SessionSharingBox" Margin="0,0,0,2">
                            <AccessText TextWrapping="Wrap" Text="{x:Static loc:Strings.SettingsSessionSharing}" />
                        </CheckBox>
                        <TextBlock Classes="OptionHelp" Text="{x:Static loc:Strings.SettingsSessionSharingHelp}" Margin="20,0,0,14" />
                        <!-- Par où les autres rejoignent mes partages : directement, sinon par le dossier relais. -->
                        <StackPanel IsEnabled="{Binding #SessionSharingBox.IsChecked}">
                            <WrapPanel Margin="0,0,0,2">
                                <CheckBox x:Name="ShareDirectBox" VerticalAlignment="Center">
                                    <AccessText Text="{x:Static loc:Strings.SettingsShareDirect}" />
                                </CheckBox>
                                <Label Content="{x:Static loc:Strings.SettingsSharePort}" Target="{Binding #SharePortBox}" Margin="16,0,4,0" Padding="0"
                                       VerticalAlignment="Center" />
                                <TextBox x:Name="SharePortBox" Width="70" VerticalAlignment="Center" MaxLength="5"
                                         IsEnabled="{Binding #ShareDirectBox.IsChecked}" ToolTip.Tip="{x:Static loc:Strings.SettingsSharePortTip}" />
                            </WrapPanel>
                            <TextBlock Classes="OptionHelp" Text="{x:Static loc:PlatformText.SettingsShareDirectHelp}" Margin="20,0,0,14" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Label Content="{x:Static loc:Strings.SettingsShareRelay}" Target="{Binding #ShareRelayBox}" />
                                <TextBox Grid.Column="1" x:Name="ShareRelayBox" VerticalContentAlignment="Center" MaxLength="400" />
                                <Button Grid.Column="2" Content="{x:Static loc:Strings.Browse}" Click="OnBrowseShareRelay" Margin="8,0,0,0" />
                            </Grid>
                            <TextBlock Classes="OptionHelp" Text="{x:Static loc:Strings.SettingsShareRelayHelp}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Sécurité ===== -->
            <TabItem x:Name="SecurityPage" Header="{x:Static loc:Strings.SettingsPageSecurity}">
                <DockPanel Margin="16,12">
                    <!-- Coffre local : actions immédiates, sans « Enregistrer ». -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                        <TextBlock Text="{x:Static loc:Strings.LocalStoreSection}" Classes="SectionTitle" />
                        <TextBlock x:Name="StoreText" Classes="Muted" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <WrapPanel>
                            <Button x:Name="StoreCreateButton" Content="{x:Static loc:Strings.LocalStoreCreate}" Click="OnStoreCreate" Margin="0,0,8,4" />
                            <Button x:Name="StoreUnlockButton" Content="{x:Static loc:Strings.LocalStoreUnlockMenu}" Click="OnStoreUnlock" Margin="0,0,8,4" />
                            <Button x:Name="StoreChangeButton" Content="{x:Static loc:Strings.LocalStoreChange}" Click="OnStoreChange" Margin="0,0,8,4" />
                            <Button x:Name="StoreDeleteButton" Content="{x:Static loc:Strings.LocalStoreDelete}" Click="OnStoreDelete" Margin="0,0,8,4"
                                    Theme="{StaticResource DangerButton}" />
                        </WrapPanel>
                        <TextBlock Classes="OptionHelp" Margin="0,2,0,0" Text="{x:Static loc:Strings.LocalStoreImmediate}" />
                    </StackPanel>

                    <!-- Clés de serveur acceptées : oubliées à l'enregistrement (la connexion suivante redemandera l'empreinte). -->
                    <TextBlock DockPanel.Dock="Top" Text="{x:Static loc:Strings.HostKeysSection}" Classes="SectionTitle" />
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <Button x:Name="ForgetKeysButton" DockPanel.Dock="Right" Content="{x:Static loc:Strings.ForgetSelectedKeys}"
                                Click="OnForgetHostKeys" IsEnabled="False" VerticalAlignment="Top" />
                        <TextBlock x:Name="HostKeysText" Classes="Muted" TextWrapping="Wrap" Margin="0,0,12,0" VerticalAlignment="Center" />
                    </DockPanel>
                    <DataGrid x:Name="HostKeysGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource GridLineBrush}"
                              SelectionMode="Extended" MinHeight="90" SelectionChanged="OnHostKeySelected"
                              AutomationProperties.Name="{x:Static loc:Strings.HostKeysSection}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{x:Static loc:Strings.HostKeyServer}" Width="2*"
                                                x:DataType="views:SettingsDialog+HostKeyRow" Binding="{Binding Server}" />
                            <DataGridTextColumn Header="{x:Static loc:Strings.HostKeyType}" Width="*"
                                                x:DataType="views:SettingsDialog+HostKeyRow" Binding="{Binding Algorithm}" />
                            <DataGridTextColumn Header="{x:Static loc:Strings.HostKeyFingerprint}" Width="3*"
                                                x:DataType="views:SettingsDialog+HostKeyRow" Binding="{Binding Fingerprint}"
                                                FontFamily="{StaticResource MonospaceFont}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</views:DialogWindow>
