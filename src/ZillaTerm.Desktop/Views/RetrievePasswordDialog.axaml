<views:DialogWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:ZillaTerm.App.Views"
                    xmlns:loc="clr-namespace:ZillaTerm.App.Localization"
                    x:Class="ZillaTerm.App.Views.RetrievePasswordDialog"
                    Title="{x:Static loc:Strings.RetrieveTitle}" Width="500" SizeToContent="Height" CanResize="False">
    <DockPanel>
        <!-- En-tête : le compte dont le mot de passe sera récupéré, et son safe. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource ToolbarBrush}" BorderBrush="{DynamicResource ToolbarBorderBrush}"
                BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel>
                <Image Source="{DynamicResource IconKey}" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="HeadingText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="SafeText" Classes="Muted" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" IsVisible="False" />
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel DockPanel.Dock="Bottom" Margin="16,4,16,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Classes="DialogButtons">
                <Button x:Name="CopyButton" Content="{x:Static loc:Strings.RetrieveAndCopy}" IsDefault="True" Click="OnCopy" />
                <Button x:Name="CancelButton" Content="{x:Static loc:Strings.Cancel}" IsCancel="True" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="{x:Static loc:Strings.RetrieveWorking}" Classes="Muted"
                       VerticalAlignment="Center" IsVisible="False" />
        </DockPanel>

        <StackPanel Margin="16,12,16,8">
            <!-- Ce qui va se passer : audit, presse-papiers. -->
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="•" Margin="0,0,6,0" />
                <TextBlock x:Name="AuditText" Text="{x:Static loc:Strings.RetrieveAudited}" TextWrapping="Wrap" />
            </DockPanel>
            <DockPanel Margin="0,0,0,12">
                <TextBlock Text="•" Margin="0,0,6,0" />
                <TextBlock x:Name="ClipboardText" TextWrapping="Wrap" />
            </DockPanel>
            <Grid Margin="0,0,0,4" ColumnDefinitions="90,*,8,*" RowDefinitions="Auto,Auto,Auto">
                <Label Content="{x:Static loc:Strings.ReasonLabel}" Target="{Binding #ReasonBox}" VerticalAlignment="Center" Margin="0,0,0,8" />
                <TextBox Grid.Column="1" Grid.ColumnSpan="3" x:Name="ReasonBox" Margin="0,0,0,8" VerticalContentAlignment="Center"
                         ToolTip.Tip="{x:Static loc:Strings.ReasonTip}" />
                <Label Grid.Row="1" Content="{x:Static loc:Strings.TicketLabel}" Target="{Binding #TicketSystemBox}" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TicketSystemBox" VerticalContentAlignment="Center"
                         ToolTip.Tip="{x:Static loc:Strings.TicketSystemTip}"
                         PlaceholderText="{x:Static loc:Strings.TicketSystemPlaceholder}"
                         AutomationProperties.Name="{x:Static loc:Strings.TicketSystemPlaceholder}" />
                <TextBox Grid.Row="1" Grid.Column="3" x:Name="TicketIdBox" VerticalContentAlignment="Center"
                         ToolTip.Tip="{x:Static loc:Strings.TicketIdTip}"
                         PlaceholderText="{x:Static loc:Strings.TicketIdPlaceholder}"
                         AutomationProperties.Name="{x:Static loc:Strings.TicketIdPlaceholder}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{x:Static loc:Strings.RetrieveReasonHint}"
                           Classes="Muted" TextWrapping="Wrap" Margin="0,4,0,0" />
            </Grid>
            <Border x:Name="ErrorPanel" Classes="ErrorBanner" Margin="0,8,0,0" IsVisible="False">
                <views:ErrorLine x:Name="ErrorMessage" />
            </Border>
        </StackPanel>
    </DockPanel>
</views:DialogWindow>
