<views:DialogWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:ZillaTerm.App.Views"
                    xmlns:loc="clr-namespace:ZillaTerm.App.Localization"
                    x:Class="ZillaTerm.App.Views.ParallelDialog"
                    Title="{x:Static loc:Strings.ParallelTitle}" Width="480" SizeToContent="Height" CanResize="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="IntroText" TextWrapping="Wrap" Margin="0,0,0,10" />
        <Border BorderBrush="{DynamicResource ToolbarBorderBrush}" BorderThickness="1" Padding="8,6" Margin="0,0,0,6">
            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SessionsPanel" />
            </ScrollViewer>
        </Border>
        <TextBlock x:Name="CountText" Classes="Muted" Margin="0,0,0,8" />
        <TextBlock x:Name="BroadcastNote" Text="{x:Static loc:Strings.ParallelDialogBroadcast}" Classes="Muted" TextWrapping="Wrap" Margin="0,0,0,12" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ShowButton" Content="{x:Static loc:Strings.ParallelShow}" IsDefault="True" Click="OnShow" />
            <Button Content="{x:Static loc:Strings.Cancel}" IsCancel="True" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</views:DialogWindow>
