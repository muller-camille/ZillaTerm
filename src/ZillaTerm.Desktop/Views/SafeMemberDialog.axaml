<views:DialogWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:ZillaTerm.App.Views"
                    xmlns:loc="clr-namespace:ZillaTerm.App.Localization"
                    x:Class="ZillaTerm.App.Views.SafeMemberDialog"
                    Title="{x:Static loc:Strings.SafeMemberWindowTitle}" Width="640" SizeToContent="Height" CanResize="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="HeadingText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{x:Static loc:Strings.SafeMemberIntro}" Classes="Muted" TextWrapping="Wrap" Margin="0,2,0,10" />

        <Grid x:Name="IdentityGrid" Margin="0,0,0,6" ColumnDefinitions="130,*,16,Auto,140" RowDefinitions="Auto,Auto">
            <Label Content="{x:Static loc:Strings.SafeMemberName}" Target="{Binding #NameBox}" Margin="0,0,8,8" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" x:Name="NameBox" Margin="0,0,0,8" VerticalContentAlignment="Center"
                     ToolTip.Tip="{x:Static loc:Strings.SafeMemberNameTip}" />
            <Label Grid.Column="3" Content="{x:Static loc:Strings.SafeMemberTypeLabel}" Target="{Binding #TypeBox}" Margin="0,0,8,8"
                   VerticalAlignment="Center" />
            <ComboBox Grid.Column="4" x:Name="TypeBox" Margin="0,0,0,8" HorizontalAlignment="Stretch" />
            <Label Grid.Row="1" x:Name="SearchInLabel" Content="{x:Static loc:Strings.SafeMemberSearchIn}" Target="{Binding #SearchInBox}"
                   Margin="0,0,8,8" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="SearchInBox" Text="Vault" Margin="0,0,0,8" VerticalContentAlignment="Center"
                     ToolTip.Tip="{x:Static loc:Strings.SafeMemberSearchInTip}" />
            <Label Grid.Row="1" Grid.Column="3" Content="{x:Static loc:Strings.SafeMemberUntil}" Target="{Binding #UntilBox}" Margin="0,0,8,8"
                   VerticalAlignment="Center" />
            <CalendarDatePicker Grid.Row="1" Grid.Column="4" x:Name="UntilBox" Margin="0,0,0,8" HorizontalAlignment="Stretch"
                                ToolTip.Tip="{x:Static loc:Strings.SafeMemberUntilTip}" />
        </Grid>

        <!-- Profil : droits prédéfinis, du plus restreint au plus large ; « Personnalisé » dès qu'une case diffère. -->
        <DockPanel Margin="0,0,0,8">
            <Label Content="{x:Static loc:Strings.SafeMemberProfile}" Target="{Binding #ProfileBox}" Width="130" Padding="0,4"
                   VerticalAlignment="Center" />
            <ComboBox x:Name="ProfileBox" HorizontalAlignment="Stretch" SelectionChanged="OnProfileChanged" />
        </DockPanel>

        <!-- Accès et gestion des comptes à gauche, safe, workflow et dossiers à droite (11 droits de chaque côté). -->
        <Grid ColumnDefinitions="*,*">
            <StackPanel x:Name="LeftGroups" />
            <StackPanel Grid.Column="1" x:Name="RightGroups" />
        </Grid>

        <views:ErrorLine x:Name="ErrorMessage" IsVisible="False" Margin="0,8,0,0" />
        <DockPanel Margin="0,12,0,0">
            <!-- Modification d'un membre : droits ajoutés et retirés par rapport à ses droits actuels. -->
            <TextBlock x:Name="ChangesText" DockPanel.Dock="Left" VerticalAlignment="Center" Classes="Muted" IsVisible="False" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Classes="DialogButtons">
                <Button x:Name="SaveButton" Content="{x:Static loc:Strings.Save}" IsDefault="True" Click="OnSave" />
                <Button x:Name="CancelButton" Content="{x:Static loc:Strings.Cancel}" IsCancel="True" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="{x:Static loc:Strings.SafeMemberSaving}" Classes="Muted"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />
        </DockPanel>
    </StackPanel>
</views:DialogWindow>
