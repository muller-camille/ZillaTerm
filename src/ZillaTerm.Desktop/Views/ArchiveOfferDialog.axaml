<views:DialogWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:ZillaTerm.App.Views"
                    xmlns:loc="clr-namespace:ZillaTerm.App.Localization"
                    x:Class="ZillaTerm.App.Views.ArchiveOfferDialog"
                    Title="{x:Static loc:Strings.ArchiveOfferTitle}" Width="560" SizeToContent="Height" CanResize="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,12" />
        <CheckBox x:Name="NeverBox" Margin="0,0,0,12">
            <AccessText Text="{x:Static loc:Strings.ArchiveOfferNever}" TextWrapping="Wrap" />
        </CheckBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Classes="DialogButtons">
            <Button x:Name="ArchiveButton" IsDefault="True" Click="OnArchive" />
            <Button x:Name="FilesButton" Content="{x:Static loc:Strings.ArchiveOfferFiles}" Click="OnFiles" />
            <Button Content="{x:Static loc:Strings.Cancel}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</views:DialogWindow>
