<views:DialogWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:ZillaTerm.App.Views"
                    xmlns:loc="clr-namespace:ZillaTerm.App.Localization"
                    x:Class="ZillaTerm.App.Views.ImportProgressDialog"
                    Title="{x:Static loc:Strings.ImportTitle}" Width="1000" Height="620" MinWidth="640" MinHeight="400">
    <Window.Styles>
        <!-- Thème du tableau (Avalonia.Controls.DataGrid) : à déplacer dans App.axaml, pour toutes les fenêtres. -->
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <!-- Densité des tableaux de l'application WPF, lignes alternées. -->
        <StyleInclude Source="avares://ZillaTerm/Themes/AccountsDataGrid.axaml" />
        <!-- Couleur du résultat : vert si créé, rouge si refusé ou non importé, gris si non envoyé. -->
        <Style Selector="TextBlock.ResultText.Created">
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        </Style>
        <Style Selector="TextBlock.ResultText.Refused, TextBlock.ResultText.NotImported">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
        </Style>
        <Style Selector="TextBlock.ResultText.NotSent">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style Selector="TextBlock.ResultText.Sending">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Styles>
    <DockPanel Margin="16">
        <TextBlock x:Name="HeadingText" DockPanel.Dock="Top" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
        <ProgressBar x:Name="Progress" DockPanel.Dock="Top" Height="6" MinHeight="6" Margin="0,0,0,8" />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="8" Classes="DialogButtons">
                <Button x:Name="SaveButton" Content="{x:Static loc:Strings.ImportSaveResult}" IsEnabled="False" Click="OnSaveResult" />
                <Button x:Name="StopButton" Content="{x:Static loc:Strings.ImportStop}" Click="OnStop" />
                <Button Content="{x:Static loc:Strings.CloseButton}" IsCancel="True" />
            </StackPanel>
            <TextBlock x:Name="ProgressText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
        </DockPanel>

        <DataGrid x:Name="RowsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource GridLineBrush}"
                  ClipboardCopyMode="IncludeHeader" CanUserReorderColumns="True" BorderThickness="1"
                  BorderBrush="{DynamicResource ToolbarBorderBrush}" LoadingRow="OnLoadingRow" />
    </DockPanel>
</views:DialogWindow>
