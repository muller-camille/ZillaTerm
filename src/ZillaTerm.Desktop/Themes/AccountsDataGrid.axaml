<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tableaux (DataGrid) des fenêtres des comptes et des safes, à la densité des tableaux de l'application WPF : texte
         de 12, lignes et marges serrées (le thème Fluent du DataGrid prévoit du 15 et des lignes de 32 px). Inclus par
         chaque fenêtre avec le thème du DataGrid ; à déplacer dans App.axaml avec lui pour tous les tableaux. -->

    <Style Selector="DataGridCell">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="24" />
    </Style>
    <Style Selector="DataGridCell TextBlock#CellTextBlock">
        <Setter Property="Margin" Value="6,0,6,0" />
    </Style>
    <Style Selector="DataGridColumnHeader">
        <Setter Property="Padding" Value="6,4,0,4" />
    </Style>
    <!-- Le libellé prend aussi la place réservée à la flèche de tri (32 px) : sinon une colonne étroite (« Ligne »,
         « Lister les comptes ») coupe son en-tête. La flèche, affichée seulement sur la colonne triée, passe par-dessus la
         fin d'un libellé long. -->
    <Style Selector="DataGridColumnHeader /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Margin" Value="0,0,-26,0" />
    </Style>

    <!-- Une ligne sur deux sur un fond à peine teinté (AlternatingRowBackground de WPF) : classe posée par LoadingRow. -->
    <Style Selector="DataGridRow.Alternate">
        <Setter Property="Background" Value="{DynamicResource AlternateRowBrush}" />
    </Style>
</Styles>
