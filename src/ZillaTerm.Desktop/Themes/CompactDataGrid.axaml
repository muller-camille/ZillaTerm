<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tableaux (DataGrid, paquet Avalonia.Controls.DataGrid) : son thème Fluent, resserré à la taille des listes de
         l'application WPF (police de 12, lignes d'environ 24 px), sur le fond et les couleurs de ZillaTerm. À inclure dans
         les Window.Styles d'une fenêtre qui a un tableau : <StyleInclude Source="avares://ZillaTerm/Themes/CompactDataGrid.axaml" />. -->
    <Styles.Resources>
        <!-- Place de la flèche de tri : celle de la flèche seulement (une colonne étroite garde son titre lisible). -->
        <x:Double x:Key="DataGridSortIconMinWidth">0</x:Double>
    </Styles.Resources>

    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <Style Selector="DataGrid">
        <Setter Property="Background" Value="{DynamicResource ContentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ToolbarBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="DataGridCell">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="24" />
    </Style>
    <!-- Texte d'une colonne de texte : aligné sur le titre de la colonne. -->
    <Style Selector="DataGridCell > TextBlock">
        <Setter Property="Margin" Value="6,0" />
    </Style>
    <Style Selector="DataGridColumnHeader">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="6,0,4,0" />
        <Setter Property="Background" Value="{DynamicResource MainTabBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SidePanelForeground}" />
    </Style>
</Styles>
