<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tableaux (DataGrid, paquet Avalonia.Controls.DataGrid) : son thème Fluent, à la densité et à l'aspect des tableaux
         de l'application WPF (texte de 12, lignes d'environ 24 px, en-têtes et filets de Windows, une ligne sur deux
         teintée). Inclus une fois dans App.axaml pour toutes les fenêtres.
         Attention : le DataGrid lie ses colonnes dans les deux sens par défaut ; une donnée qui ne doit pas changer est liée
         avec Mode=OneWay (GridBinding). -->
    <Styles.Resources>
        <ResourceDictionary>
            <!-- Pas de place réservée à la flèche de tri tant que la colonne n'est pas triée : un titre court (« Ligne »,
                 « Révision ») tient dans sa colonne, comme sous WPF. -->
            <x:Double x:Key="DataGridSortIconMinWidth">0</x:Double>
            <Thickness x:Key="DataGridTextColumnCellTextBlockMargin">6,0</Thickness>
        </ResourceDictionary>
    </Styles.Resources>

    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <Style Selector="DataGrid">
        <Setter Property="Background" Value="{DynamicResource ContentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLineBrush}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource GridLineBrush}" />
    </Style>

    <!-- Historiques et listes de résultats (lecture seule, une ligne par enregistrement) : Classes="Records". -->
    <Style Selector="DataGrid.Records">
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="RowHeight" Value="24" />
        <Setter Property="ClipboardCopyMode" Value="IncludeHeader" />
    </Style>

    <!-- En-têtes de colonnes : fond et filets des en-têtes de WPF, texte à la taille du tableau. -->
    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource HeaderBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HeaderBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="6,3" />
    </Style>
    <Style Selector="DataGridColumnHeader:pointerover /template/ Grid#PART_ColumnHeaderRoot">
        <Setter Property="Background" Value="{DynamicResource HeaderHoverBrush}" />
    </Style>

    <!-- Une ligne sur deux d'un autre fond (AlternatingRowBackground de WPF) : selon sa place, ou la classe Alternate
         posée par LoadingRow (fenêtres des comptes). -->
    <Style Selector="DataGridRow:nth-child(2n)">
        <Setter Property="Background" Value="{DynamicResource AlternateRowBrush}" />
    </Style>
    <Style Selector="DataGridRow.Alternate">
        <Setter Property="Background" Value="{DynamicResource AlternateRowBrush}" />
    </Style>

    <!-- Cellules : texte à la taille du tableau, marges serrées comme sous WPF. -->
    <Style Selector="DataGridCell">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="24" />
    </Style>
    <Style Selector="DataGridCell TextBlock">
        <Setter Property="Margin" Value="6,0" />
    </Style>
</Styles>
