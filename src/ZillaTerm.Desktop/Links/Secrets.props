<Project>
  <!--
    Secrets hors Windows : protection liée au compte de l'utilisateur (coffre local des mots de passe maîtres KeePass,
    journal d'intervention). DPAPI sous Windows (Services/KeePass/DpapiProtector.cs), trousseau du bureau par
    l'API D-Bus Secret Service sous Linux (Services/Secrets).
  -->
  <ItemGroup>
    <!-- Chaque paquet est retiré puis ajouté, pour n'être jamais compté deux fois si une autre partie du portage l'ajoute
         aussi. -->
    <!-- DPAPI (Windows seulement) : fait partie du framework Windows Desktop pour ZillaTerm.App, paquet ici. -->
    <PackageReference Remove="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    <!-- Client D-Bus du trousseau : celui qu'Avalonia utilise déjà (même version). -->
    <PackageReference Remove="Tmds.DBus.Protocol" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
  </ItemGroup>
</Project>
