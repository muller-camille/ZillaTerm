<?xml version="1.0" encoding="utf-8"?>
<!--
  SSH.NET vient uniquement de local-packages : paquet patché compilé par le workflow de release du fork
  muller-camille/SSH.NET à un commit figé, téléchargé et vérifié par tools/sshnet-patched.sh. Tous les autres paquets
  viennent de nuget.org.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="sshnet-patched" value="local-packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="sshnet-patched">
      <package pattern="SSH.NET" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
